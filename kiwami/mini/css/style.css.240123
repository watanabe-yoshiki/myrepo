 }
 
#recommend .right p{
 padding-top: 25px; 
 } 
 
#recommend .pickup img{
 width: 43%; 
 }
 
#recommend .other img{
 width: 43%; 
 }
 
#recommend .ranking li{
 width: calc(49.5% - 20px);
 margin-right: 0px; 
 }
 
