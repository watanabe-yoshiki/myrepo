@charset "utf-8";
@import url('https://fonts.googleapis.com/css2?family=M+PLUS+1p:wght@400;500;700&display=swap');


#wrapper{width:100%;font-family: 'M PLUS 1p', sans-serif;font-size:16px;font-weight:400;line-height: 1.625;color:#333;background:#F2F2F2; padding-bottom: 60px; letter-spacing: 0.05em;}
#wrapper *{box-sizing:border-box;}
#wrapper .serif{font-family: "游明朝体","Yu Mincho",YuMincho,"ヒラギノ明朝 Pro","Hiragino Mincho Pro","MS P明朝","MS PMincho",serif;}
#wrapper a:hover{opacity:0.7;}
#wrapper a img:hover{opacity:0.7;}

.container{margin:auto;max-width:830px;}
.v-pc{display:block!important;}
.v-sp{display:none!important;}

.txt-gold {color: #B3963D;}

.bg-white {background-color: #fff;}

/* --------------------------------------------------------------- */
/* contents */
/* --------------------------------------------------------------- */
.contents {
	position: relative;
}
.contents + .contents {
	margin-top: 50px;
}
.contents-main {
	padding: 40px 35px 60px;
	border-radius: 11px;
	background-color: #fff;
}
.contents-slider .slick-arrow {
	position: absolute;
	top: 150px;
	width: 35px;
	height: 85px;
	background-color: #333;
	text-indent: -9999px;
	z-index: 1;
}
.contents-slider .slick-arrow::before {
	content: "";
	position: absolute;
	top: 50%;
	width: 12px;
	height: 12px;
	transform: translate(-50%, -50%) rotate(45deg);
}
.contents-slider .slick-prev {
	left: 0;
}
.contents-slider .slick-prev::before {
	left: calc(50% + 3px);
	border-bottom: 4px solid #fff;
    border-left: 4px solid #fff;
}
.contents-slider .slick-next {
	right: 0;
}
.contents-slider .slick-next::before {
	left: calc(50% - 3px);
	border-top: 4px solid #fff;
    border-right: 4px solid #fff;
}
.contents-slider .slick-dots {
	display: flex;
	justify-content: center;
	max-width: 760px;
	margin: 18px auto 0;
	gap: 20px;
}
.contents-slider .slick-dots > li {
	width: calc((100% - 60px) / 4);
}
.contents-slider .slick-dots > li button {
	width: 100%;
	height: 0;
	padding-top: 50.28571428571429%;
	text-indent: -9999px;
	background-position: center center;
	background-size: cover;
	background-repeat: no-repeat;
	opacity: 0.3;
	transition: opacity .3s linear;	
}
.contents-slider .slick-dots > li.slick-active button {
	opacity: 1;
}
.contents-ttl {
	position: absolute;
	left: 50%;
	top: 40px;
	width: 760px;
	height: 380px;
	transform: translateX(-50%);
}
.contents-ttl h2 {
	position: absolute;
	top: 46px;
	left: 68px;
}
.contents-ttl h2.limited::before {
	content: "数量限定";
	position: absolute;
	left: 0;
	top: -40px;
	color: #fff;
	padding: 0 20px;
	font-size: 22px;
	font-weight: 400;
	letter-spacing: 0.05em;
	border-radius: 19px;
	background-color: #B3963D;
}
.contents-ttl .off {
	position: absolute;
	right: 32px;
	bottom: 22px;
	width: 151px;
}
.contents-detail {
	max-width: 760px;
	margin: 27px auto 0;
}
.contents-detail h3 {
	margin-bottom: 10px;
	font-size: 24px;
	font-weight: 500;
	line-height: 1.4;
}
.contents-detail p {
	line-height: 1.6;
}
.contents-review {
	position: relative;
	max-width: 612px;
	margin: 40px auto 0;
}
.contents-review h4 {
	padding: 10px 25px;
	color: #fff;
	font-size: 24px;
	font-weight: 500;
	letter-spacing: 0.1em;
	border-radius: 12px 12px 0 0;
	background-color: #B5983F;
}
.contents-review .reviewer {
	position: absolute;
	top: 15px;
	right: 25px;
	display: flex;
	align-items: end;
}
.contents-review .reviewer p {
	color: #777;
	font-size: 14px;
	letter-spacing: 0.1em;
}
.contents-review .reviewer p .name {
	margin-left: 1em;
	font-size: 18px;
	font-weight: 500;
}
.contents-review .reviewer .img {
	width: 76px;
}
.contents-review .detail {
	padding: 60px 60px 30px;
	background-color: #EDE8DB;
}
.contents-review .detail ol {
	display: flex;
	flex-wrap: wrap;
	gap: 20px;
	counter-reset: review 0;
}
.contents-review .detail ol > li {
	display: flex;
  	flex-direction: column;
	width: calc(50% - 10px);
	background-color: #fff;
}
.contents-review .detail ol > li .txt {
	position: relative;
	padding: 15px 15px 15px 45px;
}
.contents-review .detail ol > li .txt::before {
	counter-increment: review 1;
	content: counter(review);
	position: absolute;
	left: 15px;
	top: 5px;
	font-size: 26px;
	font-weight: 500;
}
.contents-review .detail ol > li .txt p {
	font-size: 13px;
	letter-spacing: 0.1em;
}
.contents-review .detail ol > li .img {
	margin-top: auto;
}
.contents-review .detail .more {
	margin-top: 1em;
	text-align: right;
}
.contents-review .detail .more a {
	font-size: 14px;
}
.contents-review .detail .more a:hover {
	text-decoration: underline;
}
.contents-special {
	margin-top: 20px;
	padding: 20px 0 60px;
	background-color: #BBA17274;
}
.contents-special h4 {
	margin-bottom: 20px;
	color: #333;
	font-size: 24px;
	font-weight: bold;
	text-align: center;
}
.contents-special ul {
	display: flex;
	justify-content: center;
}
.contents-special ul > li {
	width: 34%;
	box-shadow: 0px 3px 6px #0000004D;
}
.contents-special ul > li + li {
	margin-left: 20px;
}
.contents-special ul > li a {
	display: block;
	background-color: #fff;
}
.contents-special ul > li .txt {
	padding: 12px 20px 20px 20px;
}
.contents-special ul > li .txt .comment {
	position: relative;
	padding-bottom: 15px;
	color: #333;
	font-size: 18px;
	font-weight: bold;
	line-height: 1.7;
	text-align: center;
	border-bottom: 1px solid #838383;
 	letter-spacing: 0px;
}
.contents-special ul > li .txt .comment::before,
.contents-special ul > li .txt .comment::after {
	content: "";
	position: absolute;
	right: 0;
	left: 0;
	width: 0;
	height: 0;
	margin-left: auto;
}
.contents-special ul > li .txt .comment::before {
	margin-right: 80px;
	bottom: -12px;
	border-style: solid;
	border-color: transparent #838383 transparent transparent;
	border-width: 0 15px 12px 0;
}
.contents-special ul > li .txt .comment::after {
	margin-right: 81px;
	bottom: -10px;
	border-style: solid;
	border-color: transparent #fff transparent transparent;
	border-width: 0 13px 10px 0;
	z-index: 10;
}
.contents-special ul > li .txt .prof {
	display: flex;
	justify-content: space-between;
	align-items: flex-end;
	margin-top: 12px;
}
.contents-special ul > li .txt .prof .name {
	width: calc(68% - 20px);
	color: #BA9E26;
	font-size: 18px;
	line-height: 1.6;
 	padding-left: 10px;
}
.contents-special ul > li .txt .prof .icon {
	width: 32%;
	/*border: 2px solid #BA9E26;*/
	border-radius: 50%;
}
.contents-item {
	max-width: 700px;
	margin: 40px auto 0;
	box-shadow: 0px 3px 6px #00000071;
}
.contents-item a {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 15px;
	color: #333;
}
.contents-item .img {
	width: 29%;
 margin-right: 20px;
}
.contents-item.off .img {
	position: relative;
}
.contents-item.off .img::before {
	content: "";
	position: absolute;
	top: 100px;
	right: 15px;
	width: 80px;
	height: 80px;
	background: url(../images/off_item.png) left top / 100% auto no-repeat;
}
.contents-item.close {
	position: relative;
}
.contents-item.close::before {
	content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.4);
    z-index: 1;
}
.contents-item.close::after {
	content: "終了しました";
    position: absolute;
    left: 50%;
    top: 50%;
    color: #fff;
    font-size: 18px;
    white-space: nowrap;
    transform: translate(-50%, -50%);
    z-index: 1;
}
.contents-item.close a {
	pointer-events: none;
}

#block-kitokito .contents-item.off .img::before {
	content: "";
	position: absolute;
	top: 0px;
	right: 5px;
	width: 80px;
	height: 80px;
	background: url(../images/off_item.png) left top / 100% auto no-repeat;
}

#block-curry .contents-item.off .img::before {
	content: "";
	position: absolute;
	top: 15px;
	right: 5px;
	width: 90px;
	height: 90px;
	background: url(../images/off_item.png) left top / 100% auto no-repeat;
}

.contents-item .detail {
	width: 71%;
}
.contents-item .detail .name {
	padding-bottom: 10px;
	margin-bottom: 10px;
	font-size: 23px;
	line-height: 1.2;
	border-bottom: 1px solid #707070;
}
.contents-item .detail .name small {
	display: block;
	font-size: 20px;
}
.contents-item .detail .price {
	display: flex;
	align-items: center;
	font-weight: bold;
}
.contents-item .detail .price .before {
	font-size: 18px;
	text-decoration: line-through;
}
.contents-item .detail .price .after {
	margin-left: 0.5em;
	font-size: 24px;
}
.contents-item .detail .btn {
	position: relative;
	max-width: 220px;
	padding: 8px;
	margin: 18px auto 0;
	color: #fff;
	font-size: 18px;
	text-align: center;
	background-color: #333;
}
.contents-item .detail .btn-end {
	pointer-events: none;
	background-color: #888888;
}


/* --------------------------------------------------------------- */
/* period */
/* --------------------------------------------------------------- */
.period {
	padding: 5px 0;
	color: #fff;
	background-color: #333;
}
.period_date {
	display: flex;
	justify-content: center;
	align-items: center;
}
.period_date span {
	padding: 0 20px;
	font-size: 16px;
	border: 1px solid #fff;
}
.period_date p {
	margin-left: 1em;
	font-size: 20px;
	font-weight: bold;
}

/* --------------------------------------------------------------- */
/* block-head */
/* --------------------------------------------------------------- */
#block-head {
	position: relative;
	background: url(../images/bg_head.jpg) center top / cover no-repeat;
}
#block-head .head-inner {
	position: relative;
	padding: 40px 0 20px;
}
#block-head .head-logo {
	position: absolute;
	left: 80px;
	top: 0;
	width: 194px;
}
#block-head .head-ttl {
	width: 61%;
	margin: 0 auto 20px;
}
#block-head .head-txt {
	color: #333;
	font-size: 16px;
	font-weight: 500;
	text-align: center;
}
#block-head .head-off {
	position: absolute;
	right: -100px;
	top: 15px;
	width: 151px;
}

/* --------------------------------------------------------------- */
/* block-top */
/* --------------------------------------------------------------- */
#block-top {
	padding: 30px 0 35px;
}
#block-top > .container {
}
#block-top .top-bnr {
	max-width: 700px;
	margin: auto;
}
#block-top .top-bnr a {
	position: relative;
	display: flex;
	align-items: end;
	padding: 10px 20px;
	border: 1px solid #BBA172;
	background-color: #fff;
	letter-spacing: 0.1em;
}
#block-top .top-bnr a::after {
	content: "";
	position: absolute;
	right: 5px;
	bottom: 5px;
	width: 25px;
	height: 25px;
	background: url(../images/link_after.png) left top / 100% auto no-repeat;
} 
#block-top .top-bnr .balloon {
	position: relative;
	padding: 5px 10px 5px 15px;
	color: #fff;
	font-size: 13px;
	font-weight: 500;
	border-radius: 13px;
	background-color: #B3963D;
}
#block-top .top-bnr .balloon::after {
	content: "";
    position: absolute;
    right: -5px;
    bottom: -3px;
    width: 14px;
    height: 14px;
    background: url(../images/balloon_after.png) left top / 100% auto no-repeat;
}
#block-top .top-bnr .txt {
	color: #B5983F;
	font-size: 18px;
	font-weight: 500;
	margin-left: 1em;
}
#block-top .top-pagelink {
	display: flex;
	justify-content: center;
	margin-top: 25px;
}
#block-top .top-pagelink > li {
	width: calc((100% - 80px) / 5);
	box-shadow: 0px 3px 6px #0000004A;
}
#block-top .top-pagelink > li + li {
	margin-left: 20px;
}
#block-top .top-pagelink > li a {
	position: relative;
	display: block;
	height: 100%;
	background-color: #fff;
}
#block-top .top-pagelink > li a::after {
	content: "";
	position: absolute;
    left: 50%;
	bottom: 15px;
    width: 8px;
    height: 8px;
    border-bottom: 1px solid #333;
    border-right: 1px solid #333;
    transform: translateX(-50%) rotate(45deg);
}
#block-top .top-pagelink > li.close {
	position: relative;
}
#block-top .top-pagelink > li.close::before {
	content: "";
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	background-color: rgba(0,0,0,0.4);
	z-index: 1;
}
#block-top .top-pagelink > li.close::after {
	content: "終了しました";
	position: absolute;
	left: 50%;
	top: 50%;
	color: #fff;
	font-size: 13px;
	white-space: nowrap;
	transform: translate(-50%, -50%);
	z-index: 1;
}
#block-top .top-pagelink > li.close a {
	pointer-events: none;
}
#block-top .top-pagelink > li .img {
	padding-top: 62.66666666666667%;
	background-position: center center;
	background-size: cover;
	background-repeat: no-repeat;
}
#block-top .top-pagelink > li.navi-01 .img {
	background-image: url(../images/navi_23.jpg);
}
#block-top .top-pagelink > li.navi-02 .img {
	background-image: url(../images/navi_24.jpg);
}
#block-top .top-pagelink > li.navi-03 .img {
	background-image: url(../images/navi_25.jpg);
}
#block-top .top-pagelink > li.navi-04 .img {
	background-image: url(../images/navi_26.jpg);
}
#block-top .top-pagelink > li.navi-05 .img {
	background-image: url(../images/navi_27.jpg);
}

#block-top .banner{
 width: 700px;
 margin: auto;
 padding-top: 40px;
 padding-bottom: 30px;
 text-align: center;
}

#block-top .banner .banner-sp{
 display: none;
}

#block-top .top-pagelink > li .txt {
	position: relative;
	padding: 10px 15px 35px;
	font-size: 13px;
}
#block-top .top-lead {
	margin-top: 40px;
	text-align: center;
	line-height: 1.6;
}
#block-top .top-lead span {
	font-weight: bold;
}

/* --------------------------------------------------------------- */
/* block-01 */
/* --------------------------------------------------------------- */
#block-01 .contents-item .detail .name small{
 font-size: 18px;
 padding-bottom: 5px;
}

#block-01 .contents-slider .slick-dots > li:nth-of-type(1) button {
	background-image: url(../images/mv_46.jpg);
}

/* --------------------------------------------------------------- */
/* block-02 */
/* --------------------------------------------------------------- */
#block-02 .contents-slider .slick-dots > li:nth-of-type(1) button {
	background-image: url(../images/mv_47.jpg);
}

/* --------------------------------------------------------------- */
/* block-03 */
/* --------------------------------------------------------------- */
#block-03 .contents-slider .slick-dots > li:nth-of-type(1) button {
	background-image: url(../images/mv_48.jpg);
}


/* --------------------------------------------------------------- */
/* block-04 */
/* --------------------------------------------------------------- */
#block-04 .contents-slider .slick-dots > li:nth-of-type(1) button {
	background-image: url(../images/mv_49.jpg);
}
#block-04 .contents-slider .slick-dots > li:nth-of-type(2) button {
	background-image: url(../images/mv_50.jpg);
}


/* --------------------------------------------------------------- */
/* block-05 */
/* --------------------------------------------------------------- */
#block-05 .contents-slider .slick-dots > li:nth-of-type(1) button {
	background-image: url(../images/mv_51.jpg);
}
#block-05 .contents-slider .slick-dots > li:nth-of-type(2) button {
	background-image: url(../images/mv_52.jpg);
}


/* --------------------------------------------------------------- */
@media screen and (min-width: 768px){
	.is-pc {display: block;} .is-tab { display: block;} .is-sp {display: none;} .img_sp {display: none;}
 
}

/* ========================================================================================= */
/* SP */
/* ========================================================================================= */

@media screen and (max-width: 1200px) {
	.is-tab {display: none;}

	/* --------------------------------------------------------------- */
	/* block-head*/
	/* --------------------------------------------------------------- */
	#block-head .head-logo {
		left: 0;
		width: 12%;
	}
	#block-head .head-off {
		right: 15px;
		width: 12%;
	}

	/* --------------------------------------------------------------- */
	/* block-top*/
	/* --------------------------------------------------------------- */
	#block-top .top-bnr a {
		align-items: center;
	}
	#block-top .top-pagelink > li .txt {
		font-size: 14px;
	}
	

}

/* --------------------------------------------------------------- */
@media screen and (max-width: 767px){
	#wrapper{font-size:11px;letter-spacing:0.04em; padding-bottom: 60px; overflow: hidden;}
	.container{padding:0 15px;}
	.v-pc{display:none!important;}
	.v-sp{display:block!important;}
	#wrapper a:hover{opacity:1;}
	#wrapper a img:hover{opacity:1;}

	.img_pc {display: none;} .is-tab {display: none;} .is-pc {display: none;} .is-sp {display: block;}


	/* --------------------------------------------------------------- */
	/* contents */
	/* --------------------------------------------------------------- */
	.contents + .contents {
		margin-top: 55px;
	}
	.contents > .container {
		padding: 0;
	}
	.contents-main {
		padding: 15px 0 25px;
	}
	.contents-slider {
		padding: 0 15px;
	}
	.contents-slider .item {
		width: auto;
		margin: 0;
	}
	.contents-slider .item img {
		max-width: 100vw;
	}
	.contents-slider .slick-arrow {
		top: 25%;
		width: 26px;
		height: 63px;
	}
	.contents-slider .slick-arrow::before {
		width: 8px;
		height: 8px;
		border-width: 2px;
	}
	.contents-slider .slick-prev {
		left: 15px;
	}
	.contents-slider .slick-next {
		right: 15px;
	}
	.contents-slider .slick-dots {
		width: 100%;
		margin-top: 8px;
		gap: 8px;
	}
	.contents-slider .slick-dots > li {
		width: calc((100% - 24px) / 4);
	}
	.contents-slider .slick-dots > li button {
		display: block;
		padding-top: 61.9047619047619%;
	}
	.contents-ttl {
		top: 15px;
		width: calc(100% - 30px);
		height: 0;
		padding-top: 50%;
	}
	.contents-ttl h2 {
		top: 35px;
		left: 50%;
		width: auto;
		transform: translateX(-50%);
	}
	.contents-ttl h2.limited::before {
		top: -25px;
		padding: 0 10px;
		font-size: 14px;
		white-space: nowrap
	}
	.contents-ttl h2 img {
		display: block;
		max-width: fit-content;
	}
	.contents-ttl h2.row-1 img {
		height: 31px;
	}
	.contents-ttl h2.row-2 img {
		height: 62px;
	}
	.contents-ttl .off {
		display: none;
	}
	.contents-detail {
		padding: 0 15px;
		margin-top: 18px;
	}
	.contents-detail p {
		font-size: 16px;
     	padding-bottom: 0px;
	}
	.contents-detail h3 {
		font-size: 18px;
		line-height: 1.5;
	}
	.contents-review {
		margin-top: 20px;
	}
	.contents-review h4 {
		padding: 15px 10px;
		font-size: 16px;
	}
	.contents-review .reviewer {
		top: 8px;
		right: 10px;
	}
	.contents-review .reviewer p {
		font-size: 10px;
	}
	.contents-review .reviewer p .name {
		font-size: 12px;
	}
	.contents-review .reviewer .img {
		width: 68px;
	}
	.contents-review .detail {
		padding: 45px 15px 30px;
	}
	.contents-review .detail ol {
		gap: 10px;
	}
	.contents-review .detail ol > li {
		width: calc(50% - 5px);
	}
	.contents-review .detail ol > li .txt {
		padding: 10px 8px 5px 25px;
	}
	.contents-review .detail ol > li .txt::before {
		top: 8px;
		left: 10px;
		font-size: 13px;
	}
	.contents-review .detail ol > li .txt p {
		font-size: 12px;
		line-height: 1.4;
	}
	.contents-review .detail .more {
		margin-top: 1em;
	}
	.contents-review .detail .more a {
		font-size: 13px;
	}
	.contents-special h4 {
		font-size: 20px;
	}
	.contents-special ul {
		display: block;
	}
	.contents-special ul > li {
		width: 62%;
		margin: auto;
	}
	.contents-special ul > li + li {
		margin: 25px auto 0;
	}
	.contents-special ul > li .txt .comment {
		font-size: 15px;
		font-weight: normal;
	}
	.contents-special ul > li .txt .comment::before {
		margin-right: 40px;
	}
	.contents-special ul > li .txt .comment::after {
		margin-right: 41px;
	}
	.contents-special ul > li .txt .prof .name {
		font-size: 14px;
	}
	.contents-item {
		position: relative;
		margin: 15px 15px 0;
		padding-bottom: 50px;
	}
	.contents-item a {
		padding-right: 5%;
	}
	.contents-item .img {
		width: 37%;
		top:-10px;
     	margin-right: 0px;
	}
	.contents-item.off .img::before {
		top: auto;
		bottom: 10px;
		right: 10px;
		width: 55px;
		height: 55px;
	} 
	.contents-item .detail {
		width: 54%;
		padding: 10px 0;
	}
	.contents-item .detail .name small {
		font-size: 16px;
	}
	.contents-item .detail .name {
		font-size: 20px;
	}
	.contents-item .detail .price {
		display: block;
	}
	.contents-item .detail .price span {
		display: block;
	}
	.contents-item .detail .price .before {
		font-size: 14px;
	}
	.contents-item .detail .price .after {
		font-size: 19px;
	}
	.contents-item .detail .btn {
		position: absolute;
		left: 50%;
		bottom: 20px;
		width: 205px;
		max-width: none;
		margin: 0;
		font-size: 15px;
		transform: translateX(-50%);
	}

	/* --------------------------------------------------------------- */
	/* period */
	/* --------------------------------------------------------------- */
	.period_date span {
		font-size: 11px;
	}
	.period_date p {
		font-size: 16px;
	}

	/* --------------------------------------------------------------- */
	/* block-head */
	/* --------------------------------------------------------------- */
	#block-head .head-logo {
		top: 0;
		left: 15px;
		width: 26%;
	}
	#block-head .head-inner {
		padding: 88px 0 25px;
	}
	#block-head .head-ttl {
		width: 75%;
		margin: 8px auto 0;
	}
	#block-head .head-txt {
		margin-top: 10px;
		font-size: 14px;
	}
	#block-head .head-off {
		right: 7px;
		top: 8px;
		width: 22%;
	}

	/* --------------------------------------------------------------- */
	/* block-top */
	/* --------------------------------------------------------------- */
	#block-top {
		padding: 20px 0;
	}
	#block-top .top-bnr a {
		padding: 9px 6px;
	}
	#block-top .top-bnr a::after {
		right: 4px;
		bottom: 4px;
		width: 23px;
		height: 23px;
	}
	#block-top .top-bnr .balloon {
		padding: 5px;
		font-size: 12px;
		line-height: 1.25;
	}
	#block-top .top-bnr .balloon::after {
		width: 15px;
		height: 15px;
	}
	#block-top .top-bnr .txt {
		font-size: 16px;
	}
	#block-top .top-pagelink {
		justify-content: center;
		flex-wrap: wrap;
		gap: 8px 5px;
	}
	#block-top .top-pagelink > li{
		width: calc((100% - 20px) / 3);
	}
	#block-top .top-pagelink > li + li {
		margin-left: 0;
	}
	#block-top .top-pagelink > li a::after {
		bottom: 10px;
		width: 5px;
		height: 5px;
	}
	#block-top .top-pagelink > li.close::after {
		font-size: 9px;
	}
	#block-top .top-pagelink > li .img {
		width: 100%;
		padding-top: 60%;
	}
	#block-top .top-pagelink > li .txt {
		padding: 3px 3px 25px;
		font-size: 9px;
		font-weight: normal;
	}
	#block-top .top-lead {
		margin-top: 1em;
		font-size: 16px;
	}
}

@media screen and (max-width: 600px){
}

@media screen and (max-width: 425px){
}

/* ======================================================================================================================= */
/* for IE */
/* ======================================================================================================================= */
@media screen\0 {
	#wrapper .serif{font-family:"游明朝体","Yu Mincho",YuMincho,"ヒラギノ明朝 Pro","Hiragino Mincho Pro","MS P明朝","MS PMincho",serif;}
	#block-mv .btn a{padding-top:14px;padding-bottom:10px;}
	#block-ranking .tab-ranking > li{padding-top:14px;padding-bottom:7px;}}