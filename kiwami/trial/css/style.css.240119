@charset "utf-8";
@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&family=Noto+Serif+JP:wght@400;700&display=swap');


#wrapper{width:100%;font-family: 'Noto Sans JP','Yu Gothic', 'YuGothic', 'Hiragino Kaku Gothic ProN', 'Meiryo', sans-serif;font-size:16px;color:#888;background:#fff; padding-bottom: 60px;}
#wrapper *{box-sizing:border-box;}
#wrapper .serif{font-family: 'Noto Serif JP',"游明朝体","Yu Mincho",YuMincho,"ヒラギノ明朝 Pro","Hiragino Mincho Pro","MS P明朝","MS PMincho",serif;}
#wrapper a:hover{opacity:0.7;}
#wrapper a img:hover{opacity:0.7;}

.container{margin:auto;max-width:1040px;padding:0 20px;}
.v-pc{display:block!important;}
.v-sp{display:none!important;}

.txt-gold {color: #BBA172;}


/* --------------------------------------------------------------- */
/* contents */
/* --------------------------------------------------------------- */
.contents {
	position: relative;
}
.contents + .contents {
	margin-top: 130px;
}
.contents-slider .item {
	width: 700px;
	margin: 0 10px;
}
.contents-slider .slick-arrow {
	position: absolute;
	top: 50%;
	width: 36px;
	height: 61px;
	margin-top: -30.5px;
	background-color: #333;
	text-indent: -9999px;
	transform: translate(-50%, -50%);
	z-index: 1;
}
.contents-slider .slick-arrow::before {
	content: "";
	position: absolute;
	top: 50%;
	width: 18px;
	height: 18px;
	transform: translate(-50%, -50%) rotate(45deg);
}
.contents-slider .slick-prev {
	left: calc(50% - 332px);
}
.contents-slider .slick-prev::before {
	left: calc(50% + 5px);
	border-bottom: 3px solid #fff;
    border-left: 3px solid #fff;
}
.contents-slider .slick-next {
	right: calc(50% - 368px);
}
.contents-slider .slick-next::before {
	left: calc(50% - 5px);
	border-top: 3px solid #fff;
    border-right: 3px solid #fff;
}
.contents-slider .slick-dots {
	display: flex;
	justify-content: center;
	max-width: 700px;
	margin: 10px auto 0;
	gap: 0 1.25%;
}
.contents-slider .slick-dots > li {
	width: 19%;
}
.contents-slider .slick-dots > li button {
	width: 100%;
	height: 0;
	padding-top: 65.38461538461538%;
	text-indent: -9999px;
	background-position: center center;
	background-size: cover;
	background-repeat: no-repeat;
	opacity: 0.3;
	transition: opacity .3s linear;	
}
.contents-slider .slick-dots > li.slick-active button {
	opacity: 1;
}
.contents-ttl {
	position: absolute;
	left: 50%;
	top: 0;
	width: 700px;
	transform: translateX(-50%);
}
.contents-ttl .off {
	width: 21%;
}
.contents-detail {
	max-width: 700px;
	margin: 20px auto 0;
}
.contents-detail h3 {
	margin-bottom: 10px;
	font-size: 24px;
	font-weight: bold;
	line-height: 1.4;
}
.contents-detail p {
	line-height: 1.6;
 padding-bottom: 30px;
}
.contents-special {
	margin-top: 20px;
	padding: 20px 0 60px;
	background-color: #BBA17274;
}
.contents-special h4 {
	margin-bottom: 20px;
	color: #333;
	font-size: 24px;
	font-weight: bold;
	text-align: center;
}
.contents-special ul {
	display: flex;
	justify-content: center;
}
.contents-special ul > li {
	width: 34%;
	box-shadow: 0px 3px 6px #0000004D;
}
.contents-special ul > li + li {
	margin-left: 20px;
}
.contents-special ul > li a {
	display: block;
	background-color: #fff;
}
.contents-special ul > li .txt {
	padding: 12px 20px 20px 20px;
}
.contents-special ul > li .txt .comment {
	position: relative;
	padding-bottom: 15px;
	color: #333;
	font-size: 18px;
	font-weight: bold;
	line-height: 1.7;
	text-align: center;
	border-bottom: 1px solid #838383;
 	letter-spacing: 0px;
}
.contents-special ul > li .txt .comment::before,
.contents-special ul > li .txt .comment::after {
	content: "";
	position: absolute;
	right: 0;
	left: 0;
	width: 0;
	height: 0;
	margin-left: auto;
}
.contents-special ul > li .txt .comment::before {
	margin-right: 80px;
	bottom: -12px;
	border-style: solid;
	border-color: transparent #838383 transparent transparent;
	border-width: 0 15px 12px 0;
}
.contents-special ul > li .txt .comment::after {
	margin-right: 81px;
	bottom: -10px;
	border-style: solid;
	border-color: transparent #fff transparent transparent;
	border-width: 0 13px 10px 0;
	z-index: 10;
}
.contents-special ul > li .txt .prof {
	display: flex;
	justify-content: space-between;
	align-items: flex-end;
	margin-top: 12px;
}
.contents-special ul > li .txt .prof .name {
	width: calc(68% - 20px);
	color: #BA9E26;
	font-size: 18px;
	line-height: 1.6;
 	padding-left: 10px;
}
.contents-special ul > li .txt .prof .icon {
	width: 32%;
	/*border: 2px solid #BA9E26;*/
	border-radius: 50%;
}
.contents-item {
	max-width: 700px;
	margin: 30px auto 0;
	box-shadow: 0px 3px 6px #00000071;
}
.contents-item a {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 15px;
	color: #333;
}
.contents-item .img {
	width: 29%;
 margin-right: 20px;
}
.contents-item.off .img {
	position: relative;
}
.contents-item.off .img::before {
	content: "";
	position: absolute;
	top: 100px;
	right: 15px;
	width: 80px;
	height: 80px;
	background: url(../images/off_item.png) left top / 100% auto no-repeat;
}

#block-kitokito .contents-item.off .img::before {
	content: "";
	position: absolute;
	top: 0px;
	right: 5px;
	width: 80px;
	height: 80px;
	background: url(../images/off_item.png) left top / 100% auto no-repeat;
}

#block-curry .contents-item.off .img::before {
	content: "";
	position: absolute;
	top: 15px;
	right: 5px;
	width: 90px;
	height: 90px;
	background: url(../images/off_item.png) left top / 100% auto no-repeat;
}

.contents-item .detail {
	width: 71%;
}
.contents-item .detail .name {
	padding-bottom: 10px;
	margin-bottom: 10px;
	font-size: 23px;
	line-height: 1.2;
	border-bottom: 1px solid #707070;
}
.contents-item .detail .name small {
	display: block;
	font-size: 20px;
}
.contents-item .detail .price {
	display: flex;
	align-items: center;
	font-weight: bold;
}
.contents-item .detail .price .before {
	font-size: 18px;
	text-decoration: line-through;
}
.contents-item .detail .price .after {
	margin-left: 0.5em;
	font-size: 24px;
}
.contents-item .detail .btn {
	position: relative;
	max-width: 237px;
	padding: 8px;
	margin: 15px auto 0;
	color: #fff;
	font-size: 18px;
	text-align: center;
	border-radius: 70px;
	background-color: #333;
}
.contents-item .detail .btn::after {
	content: "";
	position: absolute;
	top: 50%;
	right: 20px;
    width: 8px;
    height: 8px;
    border-top: 1px solid #fff;
    border-right: 1px solid #fff;
    transform: translateY(-50%) rotate(45deg);
}

.contents-item .detail .btn-end {
	position: relative;
	max-width: 237px;
	padding: 8px;
	margin: 15px auto 0;
	color: #fff;
	font-size: 18px;
	text-align: center;
	border-radius: 70px;
	background-color: #888888;
}


/* --------------------------------------------------------------- */
/* period */
/* --------------------------------------------------------------- */
.period {
	padding: 5px 0;
	color: #fff;
	background-color: #333;
}
.period_date {
	display: flex;
	justify-content: center;
	align-items: center;
}
.period_date span {
	padding: 0 20px;
	font-size: 16px;
	border: 1px solid #fff;
}
.period_date p {
	margin-left: 1em;
	font-size: 20px;
	font-weight: bold;
}

/* --------------------------------------------------------------- */
/* block-head */
/* --------------------------------------------------------------- */
#block-head {
	background: url(../images/bg_head.jpg) center top / cover no-repeat;
}
#block-head .head-col {
	position: relative;
	display: flex;
	align-items: center;
	padding: 20px 0;
}
#block-head .head-logo {
	width: 12%;
}
#block-head .head-ttl {
	width: 40%;
}
#block-head .head-off {
	position: absolute;
	right: 0;
	top: 50%;
	width: 36%;
	transform: translateY(-50%);
}

