/* --------------------------------------------------------------- */
@media screen and (min-width: 768px){
	.is-pc {display: block;} .is-tab { display: block;} .is-sp {display: none;} .img_sp {display: none;}
 
}

/* ========================================================================================= */
/* SP */
/* ========================================================================================= */

@media screen and (max-width: 1200px) {
	.is-tab {display: none;}
}

/* --------------------------------------------------------------- */
@media screen and (max-width:1000px) {
	.container{max-width:1000px;padding:0 5%;}
}

/* --------------------------------------------------------------- */
@media screen and (max-width: 767px){
	#wrapper{font-size:11px;letter-spacing:0.04em; padding-bottom: 60px; overflow: hidden;}
	.container{padding:0 10px;}
	.v-pc{display:none!important;}
	.v-sp{display:block!important;}
	#wrapper a:hover{opacity:1;}
	#wrapper a img:hover{opacity:1;}

	.img_pc {display: none;} .is-tab {display: none;} .is-pc {display: none;} .is-sp {display: block;}


	/* --------------------------------------------------------------- */
	/* contents */
	/* --------------------------------------------------------------- */
	.contents + .contents {
		margin-top: 120px;
	}
	.contents-slider {
		padding: 0 10px;
	}
	.contents-slider .item {
		width: auto;
		margin: 0;
	}
	.contents-slider .item img {
		max-width: 100vw;
	}
	.contents-slider .slick-arrow {
		width: 26px;
		height: 44px;
		margin-top: -22px;
		transform: translateY(-50%);
	}
	.contents-slider .slick-arrow::before {
		width: 12px;
		height: 12px;
		border-width: 2px;
	}
	.contents-slider .slick-prev {
		left: 10px;
	}
	.contents-slider .slick-next {
		right: 10px;
	}
	.contents-slider .slick-dots {
		width: 100%;
	}
	.contents-ttl {
		width: 100%;
		padding: 0 10px;
	}
	.contents-ttl .off {
		width: 26%;
		margin: 0 0 0 65%;
	}
	.contents-detail h3 {
		font-size: 20px;
	}
 	#block-ice .contents-detail h3{
		font-size: 22px;
	 }
 	#block-chorizo .contents-detail h3{
		font-size: 18px;
	 }
	.contents-detail p {
		font-size: 16px;
     	padding-bottom: 0px;
	}
	.contents-special h4 {
		font-size: 20px;
	}
	.contents-special ul {
		display: block;
	}
	.contents-special ul > li {
		width: 62%;
		margin: auto;
	}
	.contents-special ul > li + li {
		margin: 25px auto 0;
	}
	.contents-special ul > li .txt .comment {
		font-size: 15px;
		font-weight: normal;
	}
	.contents-special ul > li .txt .comment::before {
		margin-right: 40px;
	}
	.contents-special ul > li .txt .comment::after {
		margin-right: 41px;
	}
	.contents-special ul > li .txt .prof .name {
		font-size: 14px;
	}
	.contents-item {
		position: relative;
		padding-bottom: 70px;
	}
	.contents-item a {
		padding-right: 5%;
	}
	.contents-item .img {
		width: 37%;
		top:-10px;
     	margin-right: 0px;
	}
	.contents-item.off .img::before {
		top: 100px;
		bottom: 10px;
		right: 5px;
	}
 	#block-kitokito .contents-item.off .img::before{
		top: 90px;
		bottom: 10px;
		right: 5px;
		width: 41%; 
	}
 	#block-curry .contents-item.off .img::before{
		top: 90px;
		bottom: 10px;
		right: 5px;
		width: 41%; 
 	}
 
 	#block-gyoza .contents-ttl h2{
		margin: 5px 36px 0 25px;
 	}
 
  	#block-gyoza .contents-ttl .off{
		margin: 5px 55px 0 auto;
     
  	}
 
 	#block-jelly .contents-ttl h2{
		margin: 5px 36px 0 25px;
 	}
 
  	#block-jelly .contents-ttl .off{
		margin: 5px 55px 0 auto;
     
  	}
 
	.contents-item .detail {
		width: 54%;
		padding: 10px 0;
	}
	.contents-item .detail .name small {
		font-size: 16px;
	}
	.contents-item .detail .name {
		font-size: 20px;
	}
	.contents-item .detail .price {
		display: block;
	}
	.contents-item .detail .price span {
		display: block;
	}
	.contents-item .detail .price .before {
		font-size: 14px;
	}
	.contents-item .detail .price .after {
		font-size: 19px;
	}
	.contents-item .detail .btn {
		position: absolute;
		left: 50%;
		bottom: 20px;
		width: 68%;
		max-width: none;
		margin: 0;
		transform: translateX(-50%);
	}

	/* --------------------------------------------------------------- */
	/* period */
	/* --------------------------------------------------------------- */
	.period_date span {
		font-size: 11px;
	}
	.period_date p {
		font-size: 16px;
	}

	/* --------------------------------------------------------------- */
	/* block-head */
	/* --------------------------------------------------------------- */
	#block-head .head-col {
		display: block;
		padding: 10px 0 20px;
	}
	#block-head .head-logo {
		width: 22%;
		margin: auto;
	}
	#block-head .head-ttl {
		width: 75%;
		margin: 8px auto 0;
	}
	#block-head .head-off {
		position: static;
