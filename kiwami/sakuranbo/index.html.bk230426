<script>
  $(function(){
    $("#block-ranking .tab-ranking > li").on("click",function(){
      var tab = $(this).data("tab");
      $("#block-ranking .tab-ranking > li").removeClass("active");
      $(this).addClass("active");
      $("#block-ranking .tab-contents").hide();
      $("#block-ranking .tab-contents#" + tab).fadeIn(300);
    });

    $('.modal_trigger .modal_btn a').on('click', function() {
      var target = $(this).data('target');
      var modal = document.getElementById(target);
			$(modal).fadeIn();
      return false;
    });

    $('.modal_close, .modal_bg').click(function(){
			$('.modal_box').fadeOut();
    });
	});
</script>
