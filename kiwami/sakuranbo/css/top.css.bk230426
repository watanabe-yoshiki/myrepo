@charset "utf-8";
@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&family=Noto+Serif+JP:wght@400;700&display=swap');


#wrapper{width:100%;font-family: 'Noto Sans JP','Yu Gothic', 'YuGothic', 'Hiragino Kaku Gothic ProN', 'Meiryo', sans-serif;font-size:18px;color:#666;background:#fff;}
#wrapper *{box-sizing:border-box;}
#wrapper .serif{font-family: 'Noto Serif JP',"游明朝体","Yu Mincho",YuMincho,"ヒラギノ明朝 Pro","Hiragino Mincho Pro","MS P明朝","MS PMincho",serif;}
#wrapper a:hover{opacity:0.7;}
#wrapper a img:hover{opacity:0.7;}

.container{margin:auto;max-width:1040px;padding:0 20px;}
.v-pc{display:block!important;}
.v-sp{display:none!important;}
#sp-header{display: none;} 
/* --------------------------------------------------------------- */
/* MV */
/* --------------------------------------------------------------- */
#block-mv{text-align:center;height:383px;background:url(../images/mv_back3.jpg) no-repeat center 15% #f6fbff;background-size:cover;}
#block-mv .container{height:100%;position:relative;}
#block-mv .box{width:100%;height:100%;display:flex;flex-direction:column;justify-content:center;}

#block-mv .box .main-ttl{
 text-align: left;
}

#block-mv .box .main-ttl img{
 width: auto;
}

.main-ttl .all{
 width: 240px;
 padding: 10px 15px;
 background: #fff;
 text-align: center;
 margin-top: 20px;
 margin-left: 30px;
 box-shadow: 0px  3px 3px 3px #d0d0d0;
}

.main-ttl .all a{
 font-weight: 400;
font-family: 'Noto Serif JP',"游明朝体","Yu Mincho",YuMincho,"ヒラギノ明朝 Pro","Hiragino Mincho Pro","MS P明朝","MS PMincho",serif;
}

#block-mv .btn a{font-size:14px;background:rgba(255,255,255,0.9);margin-top:30px;display:inline-block;padding:12px 40px;box-shadow:0 0 10px rgba(0,0,0,0.3);color:#222;}
#block-mv .btn-close a {color: #fff; background-color: rgba(153,153,153,0.6); pointer-events: none;}
#block-mv .mv-logo{position:absolute;top:0;right:0;background:#fff;padding:12px 15px;box-shadow:2px 2px 10px rgb(0 0 0 / 10%);}

/* --------------------------------------------------------------- */
/* news */
/* --------------------------------------------------------------- */
#block-news{background:#333;color:#fff;}
#block-news .list-news{display:flex;padding:10px 0;}
#block-news .list-news dd{align-self:center;margin-left:20px;}
#block-news a{color:#fff;text-decoration:underline;font-size:14px;display:block;line-height:1.4;}
#block-news a:hover{text-decoration:none;}

/* --------------------------------------------------------------- */
/* menu */
/* --------------------------------------------------------------- */
#block-menu{background:#fce8e8;}
#block-menu .banner{text-align:center;padding:30px 0 0;}
#block-menu .banner .sp{display:none;}
#block-menu .list-menu{padding:30px 0;display:flex;}
#block-menu .list-menu > li{flex:1;margin-right:20px;}
#block-menu .list-menu > li:last-child{margin-right:0;}
#block-menu .list-menu > li a{display:block;background:#fff;font-size:16px;text-align:center;padding:18px 0 32px;position:relative;white-space:nowrap;}
#block-menu .list-menu > li a::after{content:"";display:block;width: 0;height: 0;border-style: solid;border-width: 6px 7.5px 0 7.5px;border-color: #f4a3a3 transparent transparent transparent;position:absolute;bottom:15px;left:50%;margin-left:-7px;transition:bottom .3s ease;}
#block-menu .list-menu > li a:hover::after{bottom:12px;}

/* --------------------------------------------------------------- */
/* lead */
/* --------------------------------------------------------------- */
#block-lead{text-align:center;line-height:1.8;padding:40px 0 40px;}
#block-lead p span{background:#ffe5e5;}

/* --------------------------------------------------------------- */
/* banner */
/* --------------------------------------------------------------- */
#block-banner {margin-top: 30px;}
#block-banner .banner img {margin: auto;}

/* --------------------------------------------------------------- */
/* mothers */
/* --------------------------------------------------------------- */
#block-mothers{background:url(../images/mothers_back.png);padding:60px 0;}
#block-mothers .box{background:url(../images/mothers_back02.jpg) no-repeat right top #fff;padding:60px;background-size:26% auto;}
#block-mothers .ttl{margin-bottom:40px;}
#block-mothers .lead{line-height:1.8;margin-bottom:50px;}
#block-mothers .lead span{background:#ffe5e5;}
#block-mothers .list-mothers{display:flex;}
#block-mothers .list-mothers > li{flex:1;position:relative;}
#block-mothers .list-mothers > li + li{margin-left:20px;}
#block-mothers .list-mothers .list-box-wrap{display:flex;height:100%;padding-bottom:65px;}
#block-mothers .list-mothers .list-box-wrap .list-box + .list-box{margin-left:20px;}
#block-mothers .list-mothers .list-box{border:1px solid #ccc;padding:15px 24px 24px;font-size:14px;height:100%;flex:1;}
#block-mothers .list-mothers .list-box a{display:block;height:100%;}
#block-mothers .list-mothers .list-box .img{margin-bottom:10px;text-align:center;}
#block-mothers .list-mothers .list-box .name{text-decoration:underline;letter-spacing:0;}
#block-mothers .list-mothers .list-box .bottom{margin-top:10px;}
#block-mothers .list-mothers .list-box .label{background:#999;color:#fff;font-size:12px;text-align:center;display:inline-block;padding:0px 15px 1px;letter-spacing:0.05em;}
#block-mothers .list-mothers .list-box .price{margin-top:5px;font-weight:bold;font-size:18px;letter-spacing:0.04em;color:#000;}
#block-mothers .list-mothers .list-box .price small{font-size:12px;font-weight:normal;color:#666;}
#block-mothers .list-mothers .list-box.big .bottom{display:flex;align-items:center;}
#block-mothers .list-mothers .list-box.big .price{margin-left:12px;margin-top:0;}
#block-mothers .list-mothers .btn{text-align:center;position:absolute;right:0;bottom:0;width:100%;}
#block-mothers .list-mothers .btn a{display:inline-block;font-size:16px;color:#ff6565;border:1px solid #ff6565;padding:10px 30px;vertical-align:bottom;}
#block-mothers .list-mothers .btn a:hover{background:#ff6565;color:#fff;}


/* --------------------------------------------------------------- */
/* first-mother */
/* --------------------------------------------------------------- */
#block-first-mother{
 background:url(../images/first_back_pink.png) repeat center top #fff;
 padding:60px 0;
}

#block-first-mother .box{
 background:#fff;
 padding:60px;
 background:url(../images/first_right.png) no-repeat right top #fff;
}

#block-first-mother .ttl{
 margin-bottom:40px;
 text-align:left;
}

#block-first-mother .lead{
 line-height: 2.1;
 margin-bottom: 50px;
 text-align:left;
}

#block-first-mother .lead span{
 background:#ffe5e5;
}

#block-first-mother .list-first{
 display:flex;
}

#block-first-mother .list-first > li{
 flex:1;position:relative;
}

#block-first-mother .list-first > li + li{
 margin-left:20px;
}

#block-first-mother .list-first .list-box-wrap{
 display:flex;
 height:100%;
 padding-bottom:65px;
}

#block-first-mother .list-first .list-box-wrap .list-box + .list-box{
 margin-left:20px;
}

#block-first-mother .list-first .list-box{
 border:1px solid #ccc;
 padding:15px 24px 24px;
 font-size:14px;
 height:100%;
 flex:1;
}

#block-first-mother .list-first .list-box a{
 display:block;
 height:100%;
}

#block-first-mother .list-first .list-box .img{
 margin-bottom:10px;
 text-align:center;
}

#block-first-mother .list-first .list-box .name{
 text-decoration:underline;
 letter-spacing:0;
}

#block-first-mother .list-first .list-box .bottom{
 margin-top:10px;
}

#block-first-mother .list-first .list-box .label{
 background:#999;
 color:#fff;
 font-size:12px;
 text-align:center;
 display:inline-block;
 padding:0px 15px 1px;
 letter-spacing:0.05em;
}

#block-first-mother .list-first .list-box .price{
 margin-top:5px;
 font-weight:bold;
 font-size:18px;
 letter-spacing:0.04em;
 color:#000;
}

#block-first-mother .list-first .list-box .price small{
 font-size:12px;
 font-weight:normal;
 color:#666;
}

#block-first-mother .list-first .list-box.big .bottom{
 display:flex;
 align-items:center;
}

#block-first-mother .list-first .list-box.big .price{
 margin-left:12px;
 margin-top:0;
}

#block-first-mother .list-first .btn{
 text-align:center;
 position:absolute;
 right:0;
 bottom:0;
 width:100%;
}

#block-first-mother .list-first .btn a{
 display:inline-block;
 font-size:16px;
 color:#FF6565;
 border:1px solid #FF6565;
 padding:10px 30px;
 vertical-align:bottom;
}

#block-first-mother .list-first .btn a:hover{
 background:#FF6565;
 color:#fff;
}

/* --------------------------------------------------------------- */
/* first */
/* --------------------------------------------------------------- */
#block-first{background:#eff9d1;padding:60px 0;}
#block-first .box{background:url(../images/first_back.png) repeat-x center top #fff;padding:60px;}
#block-first .ttl{margin-bottom:40px;text-align:center;}
#block-first .lead{line-height:1.8;margin-bottom:50px;text-align:center;}
#block-first .lead span{background:#ffe5e5;}
#block-first .list-first{display:flex;}
#block-first .list-first > li{flex:1;position:relative;}
#block-first .list-first > li + li{margin-left:20px;}
#block-first .list-first .list-box-wrap{display:flex;height:100%;padding-bottom:65px;}
#block-first .list-first .list-box-wrap .list-box + .list-box{margin-left:20px;}
#block-first .list-first .list-box{border:1px solid #ccc;padding:15px 24px 24px;font-size:14px;height:100%;flex:1;}
#block-first .list-first .list-box a{display:block;height:100%;}
#block-first .list-first .list-box .img{margin-bottom:10px;text-align:center;}
#block-first .list-first .list-box .name{text-decoration:underline;letter-spacing:0;}
#block-first .list-first .list-box .bottom{margin-top:10px;}
#block-first .list-first .list-box .label{background:#999;color:#fff;font-size:12px;text-align:center;display:inline-block;padding:0px 15px 1px;letter-spacing:0.05em;}
#block-first .list-first .list-box .price{margin-top:5px;font-weight:bold;font-size:18px;letter-spacing:0.04em;color:#000;}
#block-first .list-first .list-box .price small{font-size:12px;font-weight:normal;color:#666;}
#block-first .list-first .list-box.big .bottom{display:flex;align-items:center;}
#block-first .list-first .list-box.big .price{margin-left:12px;margin-top:0;}
#block-first .list-first .btn{text-align:center;position:absolute;right:0;bottom:0;width:100%;}
#block-first .list-first .btn a{display:inline-block;font-size:16px;color:#8eb714;border:1px solid #8eb714;padding:10px 30px;vertical-align:bottom;}
#block-first .list-first .btn a:hover{background:#8eb714;color:#fff;}

/* --------------------------------------------------------------- */
/* recommend */
/* --------------------------------------------------------------- */
#block-recommend {padding: 80px 0 160px; background-color: #C6C59D;}
#block-recommend .ttl {margin-bottom: 40px; color: #000; text-align: center; font-size: 44px; font-weight: normal;}
#block-recommend .list-recommend {display: flex; justify-content: space-between; flex-wrap: wrap;}
#block-recommend .list-recommend > li {position: relative; width: 48%; box-shadow: 5px 5px 5px rgba(0,0,0,0.1);}
#block-recommend .list-recommend > li:nth-of-type(n+3) {margin-top: 45px;}
#block-recommend .list-recommend > li .detail {position: absolute; left: 0; bottom: 0; padding: 30px 40px 20px;  background-color: rgba(255,255,255,0.68); letter-spacing: 0.05em;}
#block-recommend .list-recommend > li .name {margin-bottom: 10px; color: #666600; font-family: fot-tsukuardgothic-std, sans-serif; font-size: 44px; font-weight: 700; font-style: normal; text-align: center;}
#block-recommend .list-recommend > li .txt {color: #333; font-size: 18px; line-height: 1.9;}
#block-recommend .list-recommend > li .btn {width: 240px; margin: 10px auto 0;}
#block-recommend .list-recommend > li .btn a {display: flex; justify-content: center; align-items: center; height: 40px; color: #fff; font-size: 22px; background-color: #666600;}
#block-recommend .list-recommend > li .btn-close a {font-size: 14px; background-color: #666; pointer-events: none;}

/* --------------------------------------------------------------- */
/* ranking */
/* --------------------------------------------------------------- */
#block-ranking{padding:80px 0;}
#block-ranking .ttl{text-align:center;margin-bottom:70px;}
#block-ranking .tab-ranking{display:flex;justify-content:center;margin-bottom:30px;}
#block-ranking .tab-ranking > li{flex:1;text-align:center;background:#c1c1c1;color:#fff;position:relative;padding:9px 10px 11px;font-size:22px;cursor:pointer;transition:.3s ease;}
#block-ranking .tab-ranking > li::after{content:"";display:block;width: 0;height: 0;border-style: solid;border-width: 12px 9px 0 9px;border-color: #f4a3a3 transparent transparent transparent;position:absolute;left:50%;margin-left:-9px;bottom:-11px;opacity:0;transition:.3s ease;}
#block-ranking .tab-ranking > li + li{margin-left:2px;}
#block-ranking .tab-ranking > li.active{background:#f4a3a3;}
#block-ranking .tab-ranking > li.active::after{opacity:1;}
#block-ranking .tab-contents{display:none;}
#block-ranking .tab-contents.active{display:block;}
#block-ranking .tab-contents .list-ranking{display:flex;}
#block-ranking .tab-contents .list-ranking > li{padding:0 10px;font-size:14px;height:100%;flex:1;}
#block-ranking .tab-contents .list-ranking > li a{display:block;height:100%;}
#block-ranking .tab-contents .list-ranking > li.close a {position: relative; pointer-events: none;}
#block-ranking .tab-contents .list-ranking > li.close a:before {content: ""; position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(255,255,255,0.4);}
#block-ranking .tab-contents .list-ranking > li.close a:after {content: "終了しました"; position: absolute; left: 50%; top: 50%; display: inline-block; padding: 5px 10px; color: #fff; font-size: 14px; line-height: 1; white-space: nowrap; background-color: #666; transform:translate(-50%,-50%); z-index: 1;}
#block-ranking .tab-contents .list-ranking > li .img{margin-bottom:10px;text-align:center;}
#block-ranking .tab-contents .list-ranking > li .name{text-decoration:underline;letter-spacing:0;}
#block-ranking .tab-contents .list-ranking > li .bottom{margin-top:10px;}
#block-ranking .tab-contents .list-ranking > li .label{background:#999;color:#fff;font-size:12px;text-align:center;display:inline-block;padding:0px 15px 1px;letter-spacing:0.05em;}
#block-ranking .tab-contents .list-ranking > li .price{margin-top:5px;font-weight:bold;font-size:18px;letter-spacing:0.04em;color:#000;}
#block-ranking .tab-contents .list-ranking > li .price small{font-size:12px;font-weight:normal;color:#666;}

/* --------------------------------------------------------------- */
/* package */
/* --------------------------------------------------------------- */
#block-package{padding:80px 0;background:#fcf7e8;text-align:center;}
#block-package .ttl{text-align:center;font-size:31px;font-weight:bold;color:#000;}
#block-package .ttl::after{content:"";display:block;width:115px;height:3px;background:#000;margin:5px auto 40px;}
#block-package .lead{line-height:1.8;margin-bottom:50px;}
#block-package .list-package{display:flex;flex-wrap:wrap;justify-content:center;max-width:900px;margin:auto;}
#block-package .list-package > li{background:#fff;width:calc((100% - 30px) / 3);margin-right:15px;margin-bottom:15px;padding:20px 10px;}
#block-package .list-package > li:nth-child(3n){margin-right:0;}
#block-package .list-package > li.close {position: relative;}
#block-package .list-package > li.close:before {content: ""; position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(255,255,255,0.4);}
#block-package .list-package > li.close:after {content: "終了しました"; position: absolute; left: 50%; top: 50%; display: inline-block; padding: 5px 10px; color: #fff; font-size: 14px; line-height: 1; white-space: nowrap; background-color: #666; transform:translate(-50%,-50%); z-index: 1;}
#block-package .list-package > li.close a {pointer-events: none;}
#block-package .list-package > li p{font-size:24px;margin:10px auto;}

/* --------------------------------------------------------------- */
/* price */
/* --------------------------------------------------------------- */
#block-price{padding:80px 0;text-align:center;}
#block-price .ttl{text-align:center;font-size:31px;font-weight:bold;color:#000;}
#block-price .ttl::after{content:"";display:block;width:115px;height:3px;background:#000;margin:5px auto 40px;}
#block-price .lead{line-height:1.8;margin-bottom:50px;}
#block-price .list-price01{display:flex;flex-wrap:wrap;justify-content:space-between;margin-top: 80px;}
#block-price .list-price01::after {content: ""; width: 64%;}
#block-price .list-price01 > li{font-size:23px;width: 32%;}
#block-price .list-price01 > li:nth-of-type(n+4) {margin-top: 80px;}
#block-price .list-price01 > li a{display:block;}
#block-price .list-price01 > li.close a {pointer-events: none;}
#block-price .list-price01 > li figure {position: relative;}
#block-price .list-price01 > li.close figure {position: relative;}
#block-price .list-price01 > li.close figure:before {content: ""; position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(255,255,255,0.4);}
#block-price .list-price01 > li.close figure:after {content: "終了しました"; position: absolute; left: 50%; top: 50%; display: inline-block; padding: 5px 10px; color: #fff; font-size: 14px; line-height: 1; white-space: nowrap; background-color: #666; transform:translate(-50%,-50%); z-index: 1;}
#block-price .list-price01 > li figcaption {position: relative; left: 0; bottom: 0; display: flex; justify-content: center; align-items: center; width: 100%; height: 50px; color: #000; font-size: 23px; letter-spacing: 0.05em; background-color: rgba(255,255,255,0.68);}
#block-price .list-price01 > li p {margin-top:15px; color: #666; font-size: 14px; text-align: left; letter-spacing: 0.05em; line-height: 1.5;}
#block-price .list-price02{display:flex;flex-wrap:wrap;justify-content:center;margin-top: 50px;}
#block-price .list-price02 > li{font-size:20px;margin:15px;}
#block-price .list-price02 > li a{display:block;color:#fff;padding:12px 40px;min-width:270px;background:#f4a3a3;border-radius:100px;}

/* --------------------------------------------------------------- */
/* review */
/* --------------------------------------------------------------- */
#block-review{padding:60px 0;text-align:center;background:url(../images/review_back.png);}
#block-review .ttl{text-align:center;margin-bottom:50px;display:inline-block;background:#fff;border-radius:10px;padding:12px 60px;}
#block-review .list-review{display:flex;flex-wrap:wrap;}
#block-review .list-review > li{padding:40px;background:#fff;width:calc((100% - 15px) / 2);margin:0 15px 15px 0;}
#block-review .list-review > li:nth-child(even){margin-right:0;}
#block-review .list-review > li a{display:block;overflow:visible;}
#block-review .list-review > li .img{position:relative;}
#block-review .list-review > li .img img{border-radius:5px;}
#block-review .list-review > li .img .person{position:absolute;right:-20px;bottom:-20px;}
#block-review .list-review > li .info{margin-top:35px;text-align:left;line-height:1.75;}
#block-review .list-review > li .name{text-align:right;margin-top:15px;font-weight:bold;}

/* --------------------------------------------------------------- */
/* pickup */
/* --------------------------------------------------------------- */
#block-pickup{padding:60px 0;background:#fce8e8;}
#block-pickup .ttl{text-align:center;margin-bottom:50px;}
#block-pickup .list-pickup{display:flex;flex-wrap:wrap;justify-content:center;}
#block-pickup .list-pickup > li{width:calc((100% - 48px) / 4);margin-right:16px;margin-bottom:16px;}
#block-pickup .list-pickup > li:nth-child(4n){margin-right:0;}
#block-pickup .list-pickup > li a{display:block;}
#block-pickup .list-pickup > li .img{margin-bottom:15px;}
#block-pickup .list-pickup > li .name{font-size:14px;}
#block-pickup .list-pickup > li  .price{margin-top:5px;font-weight:bold;font-size:18px;letter-spacing:0.04em;color:#000;}
#block-pickup .list-pickup > li  .price small{font-size:12px;font-weight:normal;color:#666;margin-left:3px;}

/* --------------------------------------------------------------- */
/* kodawari */
/* --------------------------------------------------------------- */
#block-kodawari{padding:60px 0;color:#222;}
#block-kodawari .ttl{text-align:center;position:relative;margin-bottom:30px;}
#block-kodawari .ttl span{display:inline-block;background:#fff;padding:0 15px;position:relative;z-index:2;font-size:32px;font-weight:normal;}
#block-kodawari .ttl::after{content:"";display:block;width:100%;height:1px;background:#222;position:absolute;top:50%;margin-top:-1px;left:0;z-index:1;}
#block-kodawari .sub-ttl{background:#222;color:#fff;text-align:center;font-size:22px;font-weight:bold;border-radius:5px;margin-bottom:30px;padding:20px;}
#block-kodawari .lead{line-height:1.5;max-width:910px;margin:auto;color:#666;line-height:1.75;margin-bottom:20px;}
#block-kodawari .modal_trigger{display:flex;flex-wrap:wrap;max-width:910px;margin:0 auto 60px;}
#block-kodawari .modal_trigger > li{width:calc((100% - 45px) / 4);margin:0 15px 15px 0;}
#block-kodawari .modal_trigger > li:nth-child(4n){margin-right:0;}
#block-kodawari .modal_trigger > li img{width:100%;}
#block-kodawari .pride-wrap{line-height:1.8;color:#666;max-width:910px;margin:auto;}
#block-kodawari .pride-wrap .txt{float:left;width:50%;}
#block-kodawari .pride-wrap .map{float:right;width:47%;margin-left:2%;}
#block-kodawari .pride-wrap .clear{clear:both;padding-top:20px;}
#block-kodawari .pride-wrap p + p{margin-top:20px;}

#block-kodawari .modal_box{display:none;height:100%;left:0;position:fixed;top:0;width:100%;z-index:9999}
#block-kodawari .modal_bg{background-color:rgba(30,30,30,0.9);height:100%;width:100%}
#block-kodawari .modal_inner{background-color:#fff;left:50%;position:absolute;top:50%;-webkit-transform:translate(-50%,-50%);transform:translate(-50%,-50%);width:750px}
#block-kodawari .modal_block .modal_ttl{padding:8px;font-size:18px;color:#fff;text-align:center;font-weight:700;background:#360;font-family:"游明朝体","Yu Mincho",YuMincho,"ヒラギノ明朝 Pro","Hiragino Mincho Pro","MS P明朝","MS PMincho",serif}
#block-kodawari .modal_block .modal_contents{display:flex;justify-content:space-between;align-items:flex-start;padding:40px}
#block-kodawari .modal_block .modal_contents img{width:44%}
#block-kodawari .modal_block .modal_contents dl{width:52%}
#block-kodawari .modal_block .modal_contents dl dt{font-size:20px;font-weight:700;font-family:"游明朝体","Yu Mincho",YuMincho,"ヒラギノ明朝 Pro","Hiragino Mincho Pro","MS P明朝","MS PMincho",serif}
#block-kodawari .modal_block .modal_contents dl dd{font-size:14px;font-family:"游明朝体","Yu Mincho",YuMincho,"ヒラギノ明朝 Pro","Hiragino Mincho Pro","MS P明朝","MS PMincho",serif;margin-top:8px}
#block-kodawari .modal_close{cursor:pointer;position:absolute;right:14px;top:-6px;color:#fff;font-size:2rem}

#block-kodawari .list_owner {display: flex; flex-wrap: wrap; margin-bottom: 60px;}
#block-kodawari .list_owner > li {width: 22.5%; margin-right: 3.3%; text-align: center;}
#block-kodawari .list_owner > li img{width: 220px;height: 180px;object-fit: cover;}
#block-kodawari .list_owner > li:nth-of-type(4n) {margin-right: 0;}
#block-kodawari .list_owner > li:nth-of-type(n+5) {margin-top: 25px;}
#block-kodawari .list_owner > li.award .img {position: relative;}
#block-kodawari .list_owner > li.award .img:before {content: ""; position: absolute; left: 7px; top: 7px; width: 70px; height: 91px; background: url(../images/icon_award.png) left top / 100% auto no-repeat;}
#block-kodawari .list_owner > li .name {color: #666; font-size: 20px; letter-spacing: -0.1em; line-height: 2; white-space: nowrap;}
#block-kodawari .list_owner > li .name span {font-size: 10px;}
#block-kodawari .list_owner > li a {display: flex; justify-content: center; align-items: center; color: #666; font-size: 16px; letter-spacing: 0.05em;}
#block-kodawari .list_owner > li a.close {color: #fff; font-size: 14px; background-color: #666; pointer-events: none;}


/* --------------------------------------------------------------- */
/* gift */
/* --------------------------------------------------------------- */
#block-gift{padding:80px 0;background:#e6e4cf;}
#block-gift .ttl{text-align:center;margin-bottom:30px;}
#block-gift .lead{text-align:center;font-size:17px;font-weight:bold;text-align:center;line-height:1.75;margin-bottom:40px;}
#block-gift .sub-ttl{text-align:center;position:relative;margin-bottom:30px;}
#block-gift .sub-ttl span{display:inline-block;background:#e6e4cf;padding:0 40px;font-size:27px;font-weight:bold;position:relative;z-index:2;}
#block-gift .sub-ttl::after{content:"";display:block;width:100%;height:1px;background:#666;position:absolute;top:50%;left:0;z-index:1;}
#block-gift .list-gift{display:flex;}
#block-gift .list-gift > li{flex:1;background:#fff;padding:30px 20px 40px;}
#block-gift .list-gift > li + li{margin-left:15px;}
#block-gift .list-gift > li .img{text-align:center;margin-bottom:30px;}
#block-gift .list-gift > li .list-ttl{font-size:17px;font-weight:bold;margin-bottom:15px;}
#block-gift .list-gift > li p{font-size:14px;line-height:1.75;}
#block-gift .list-gift > li a{display:block;}
#block-gift .list-gift + .sub-ttl{margin-top:60px;}

/* ========================================================================================= */
/* SP */
/* ========================================================================================= */
@media screen and (max-width:1000px) {
	.container{max-width:1280px;padding:0 5%;}

	/* --------------------------------------------------------------- */
	/* menu */
	/* --------------------------------------------------------------- */
	#block-menu .list-menu{flex-wrap:wrap;justify-content:center;}
	#block-menu .list-menu > li{margin:5px;flex:none;width:calc((100% - 30px) / 3);}
	#block-menu .list-menu > li a{font-size:14px;}

	/* --------------------------------------------------------------- */
	/* mothers */
	/* --------------------------------------------------------------- */
	#block-mothers .list-mothers{display:block;}
	#block-mothers .list-mothers > li + li{margin-left:0;margin-top:20px;}
	#block-mothers .list-mothers .list-box-wrap{padding-bottom:0;}
	#block-mothers .list-mothers .btn{position:static;margin-top:30px;}

	/* --------------------------------------------------------------- */
	/* first */
	/* --------------------------------------------------------------- */
	#block-first .list-first{display:block;}
	#block-first .list-first > li + li{margin-left:0;margin-top:20px;}
	#block-first .list-first .list-box-wrap{padding-bottom:0;}
	#block-first .list-first .btn{position:static;margin-top:30px;}
 
	/* --------------------------------------------------------------- */
	/* first */
	/* --------------------------------------------------------------- */
	#block-first-mother .list-first{display:block;}
	#block-first-mother .list-first > li + li{margin-left:0;margin-top:20px;}
	#block-first-mother .list-first .list-box-wrap{padding-bottom:0;}
	#block-first-mother .list-first .btn{position:static;margin-top:30px;}

	/* --------------------------------------------------------------- */
	/* kodawari */
	/* --------------------------------------------------------------- */
	#block-kodawari .list_owner > li {width: 30%;}
	#block-kodawari .list_owner > li:nth-of-type(4n) {margin-right: 3.3%;}
	#block-kodawari .list_owner > li:nth-of-type(3n) {margin-right: 0;}
	#block-kodawari .list_owner > li:nth-of-type(n+4) {margin-top: 25px;}

}

/* --------------------------------------------------------------- */
@media screen and (max-width: 767px){
	#wrapper{font-size:11px;letter-spacing:0.04em;}
	.container{padding:0 12px;}
	.v-pc{display:none!important;}
	.v-sp{display:block!important;}
	#wrapper a:hover{opacity:1;}
	#wrapper a img:hover{opacity:1;}

 #sp-header{
  display: block;
 }
 
	/* --------------------------------------------------------------- */
	/* MV */
	/* --------------------------------------------------------------- */
	#block-mv{height:260px;background-image:url(../images/mv_back4.jpg);background-position:left bottom;}
	#block-mv .mv-logo{width:85px;max-width:18%;padding: 10px 7px 7px;right: 5px;}
	#block-mv .main-ttl{max-width:60%;width:330px;}
	#block-mv .btn a{margin-top:15px;font-size:10px;padding:5px 15px;}
 	#block-mv .main-ttl .all{width: 160px;}
	/* --------------------------------------------------------------- */
	/* news */
	/* --------------------------------------------------------------- */
	#block-news a{font-size:10px;}
	#block-news .list-news{align-items:center;}
	#block-news .list-news dt{max-width:25%;display:flex;align-items:center;}
	#block-news .list-news dt img{vertical-align:middle;}
	#block-news .list-news dd{margin-left:10px;}

	/* --------------------------------------------------------------- */
	/* menu */
	/* --------------------------------------------------------------- */
	#block-menu .banner .sp{display:block;}
	#block-menu .banner .pc{display:none;}

	#block-menu .list-menu{padding:15px 0;}
	#block-menu .list-menu > li a{font-size:10px;letter-spacing:0;padding:12px 0 24px;}
	#block-menu .list-menu > li a::after{border-width:5px 5px 0 5px;margin-left:-5px;bottom:8px;}

	/* --------------------------------------------------------------- */
	/* lead */
	/* --------------------------------------------------------------- */
	#block-lead{padding:20px 0 20px;}

	/* --------------------------------------------------------------- */
	/* mothers */
	/* --------------------------------------------------------------- */
	#block-mothers{padding:20px 0;background-size:1.5% auto;}
	#block-mothers .ttl{max-width:78%;margin-bottom:20px;}
	#block-mothers .box{padding:25px 20px 25px;}
	#block-mothers .lead{margin-bottom:20px;}
	#block-mothers .list-mothers > li + li{margin-top:15px;}
	#block-mothers .list-mothers .list-box{padding:10px 20px 20px;font-size:10px;}
	#block-mothers .list-mothers .list-box .label{font-size:10px;padding:1px 8px 2px;}
	#block-mothers .list-mothers .list-box-wrap .list-box + .list-box{margin-left:15px;}
	#block-mothers .list-mothers .list-box .price{font-size:14px;}
	#block-mothers .list-mothers .list-box .price small{font-size:10px;}
	#block-mothers .list-mothers .list-box.big .bottom{margin-top:8px;}
	#block-mothers .list-mothers .btn{margin-top:20px;}
	#block-mothers .list-mothers .btn a{font-size:13px;max-width:100%;padding:8px 15px;}

	/* --------------------------------------------------------------- */
	/* first */
	/* --------------------------------------------------------------- */
	#block-first{padding:20px 0;}
	#block-first .ttl{max-width:58%;margin:0 auto 20px;}
	#block-first .box{padding:30px 20px 25px;background-size:auto 0px;}
	#block-first .lead{margin-bottom:20px;}
	#block-first .list-first > li + li{margin-top:15px;}
	#block-first .list-first .list-box{padding:10px 20px 20px;font-size:10px;}
	#block-first .list-first .list-box .label{font-size:10px;padding:1px 8px 2px;}
	#block-first .list-first .list-box-wrap .list-box + .list-box{margin-left:15px;}
	#block-first .list-first .list-box .price{font-size:14px;}
	#block-first .list-first .list-box .price small{font-size:10px;}
	#block-first .list-first .list-box.big .bottom{margin-top:8px;}
	#block-first .list-first .btn{margin-top:20px;}
	#block-first .list-first .btn a{font-size:13px;max-width:100%;padding:8px 15px;}
 
	/* --------------------------------------------------------------- */
	/* first-mother */
	/* --------------------------------------------------------------- */
	#block-first-mother{padding:20px 0;}
	#block-first-mother .ttl{max-width:58%;}
	#block-first-mother .box{padding:30px 20px 25px;background-size:auto 300px;}
	#block-first-mother .lead{margin-bottom:20px;}
	#block-first-mother .list-first > li + li{margin-top:15px;}
	#block-first-mother .list-first .list-box{padding:10px 20px 20px;font-size:10px;}
	#block-first-mother .list-first .list-box .label{font-size:10px;padding:1px 8px 2px;}
	#block-first-mother .list-first .list-box-wrap .list-box + .list-box{margin-left:15px;}
	#block-first-mother .list-first .list-box .price{font-size:14px;}
	#block-first-mother .list-first .list-box .price small{font-size:10px;}
	#block-first-mother .list-first .list-box.big .bottom{margin-top:8px;}
	#block-first-mother .list-first .btn{margin-top:20px;}
	#block-first-mother .list-first .btn a{font-size:13px;max-width:100%;padding:8px 15px;}

	/* --------------------------------------------------------------- */
	/* recommend */
	/* --------------------------------------------------------------- */
	#block-recommend {padding: 30px 0 85px;}
	#block-recommend .ttl {margin-bottom: 35px; font-size: 22px;}
	#block-recommend .list-recommend {margin: 0 15px;}
	#block-recommend .list-recommend > li {width: 100%;}
	#block-recommend .list-recommend > li + li {margin-top: 20px;}
	#block-recommend .list-recommend > li:nth-of-type(n+3) {margin-top: 20px;} 
	#block-recommend .list-recommend > li .detail {padding: 15px 25px;}
	#block-recommend .list-recommend > li .name {font-size: 27px;}
	#block-recommend .list-recommend > li .txt {font-size: 11px;}
	#block-recommend .list-recommend > li .btn a {font-size: 13px;}
	#block-recommend .list-recommend > li .btn-close a {font-size: 11px;}

	/* --------------------------------------------------------------- */
	/* ranking */
	/* --------------------------------------------------------------- */
	#block-ranking{padding:30px 0;}
	#block-ranking .ttl{max-width:58%;margin:0 auto 25px;}
	#block-ranking .tab-contents .list-ranking{flex-wrap:wrap;margin-bottom:-5%;}
	#block-ranking .tab-ranking > li{font-size:10px;padding:4px 5px 6px;}
	#block-ranking .tab-ranking > li::after{border-width:6px 5px 0 5px;margin-left:-4px;bottom:-6px;}
	#block-ranking .tab-contents .list-ranking > li{width:47.5%;flex:none;padding:0;margin:0 5% 5% 0;font-size:10px;}
	#block-ranking .tab-contents .list-ranking > li:nth-child(even){margin-right:0;}
	#block-ranking .tab-contents .list-ranking > li.close a:after {font-size: 11px;}
	#block-ranking .tab-contents .list-ranking > li .label{font-size:10px;padding:1px 8px 2px;}
	#block-ranking .tab-contents .list-ranking > li .price{font-size:14px;}
	#block-ranking .tab-contents .list-ranking > li .price small{font-size:10px;}

	/* --------------------------------------------------------------- */
	/* package */
	/* --------------------------------------------------------------- */
	#block-package{padding:30px 0;}
	#block-package .ttl{font-size:16px;}
	#block-package .ttl::after{height:2px;width:60px;margin-bottom:15px;}
	#block-package .lead{margin-bottom:30px;letter-spacing:0;}
	#block-package .list-package{justify-content:flex-start;max-width:90%;margin:0 auto -20px;}
	#block-package .list-package > li{width:calc((100% - 20px) / 2);margin:0 20px 20px 0;padding:5px 10px 15px;}
	#block-package .list-package > li:nth-child(3n){margin-right:20px;}
	#block-package .list-package > li:nth-child(even){margin-right:0;}
	#block-package .list-package > li.close:after {font-size: 11px;}
	#block-package .list-package > li p{font-size:11px;margin:5px auto 0;}

	/* --------------------------------------------------------------- */
	/* price */
	/* --------------------------------------------------------------- */
	#block-price{padding:30px 0;}
	#block-price .ttl{font-size:16px;}
	#block-price .ttl::after{height:2px;width:60px;margin-bottom:15px;}
	#block-price .lead{margin-bottom:30px;letter-spacing:0;}
	#block-price .list-price01{flex-wrap:wrap;max-width:95%;margin:40px auto 10px;}
	#block-price .list-price01 > li{flex:none;width:calc((100% - 20px) / 2);margin:0 20px 20px 0;font-size:11px;}
	#block-price .list-price01 > li + li{margin-left:0;}
	#block-price .list-price01 > li:nth-child(even){margin-right:0;}
	#block-price .list-price01 > li:nth-of-type(n+4) {margin-top: 0;}
	#block-price .list-price01 > li.close figure:after{font-size: 11px;}
	#block-price .list-price01 > li figcaption {height: 25px; font-size: 12px;}
	#block-price .list-price01 > li p{margin-top:10px; font-size: 10px;}
	#block-price .list-price02{margin-bottom:-15px;}
	#block-price .list-price02 > li{font-size:10px;margin:0 15px 15px 0;width:calc((100% - 15px) / 2);}
	#block-price .list-price02 > li:nth-child(even){margin-right:0;}
	#block-price .list-price02 > li a{padding:10px 10px;min-width:0;}

	/* --------------------------------------------------------------- */
	/* review */
	/* --------------------------------------------------------------- */
	#block-review{padding:30px 0;background-color:#FFE5CC;background-image: none;}
	#block-review .ttl{padding:8px 30px;margin-bottom:30px;}
	#block-review .ttl img{max-width:90%;vertical-align:top;}
	#block-review .list-review{display:block;}
	#block-review .list-review > li{width:75%;margin:0 auto 10px;padding:20px;}
	#block-review .list-review > li:nth-child(even){margin-right:auto;}
	#block-review .list-review > li .img .person{max-width:30%;right:-15px;bottom:-15px;}
	#block-review .list-review > li .info{margin-top:20px;font-size:10px;}
	#block-review .list-review > li .name{margin-top:5px;}

	/* --------------------------------------------------------------- */
	/* pickup */
	/* --------------------------------------------------------------- */
	#block-pickup{padding:30px 0;}
	#block-pickup .ttl{max-width:75%;margin:0 auto 20px;}
	#block-pickup .list-pickup{flex-wrap:wrap;max-width:85%;margin:0 auto -15px;}
	#block-pickup .list-pickup > li{width:calc((100% - 12px) / 2);margin:0 12px 15px 0;}
	#block-pickup .list-pickup > li:nth-child(even){margin-right:0;}
	#block-pickup .list-pickup > li .img{margin-bottom:10px;}
	#block-pickup .list-pickup > li .name{font-size:10px;}
	#block-pickup .list-pickup > li .price{font-size:14px;}
	#block-pickup .list-pickup > li .price small{font-size:10px;}

	/* --------------------------------------------------------------- */
	/* kodawari */
	/* --------------------------------------------------------------- */
	#block-kodawari{padding:30px 0;}
	#block-kodawari .ttl{margin-bottom:20px;}
	#block-kodawari .ttl span{font-size:16px;}
	#block-kodawari .sub-ttl{font-size:11px;margin-bottom:15px;padding:10px;}
	#block-kodawari .modal_trigger{margin-bottom:20px;}
	#block-kodawari .modal_trigger > li{width:calc((100% - 10px) / 2);margin:0 10px 10px 0;}
	#block-kodawari .modal_trigger > li:nth-child(even){margin-right:0;}
	#block-kodawari .modal_inner{width:90%;max-height:80%;overflow-y:auto;}
	#block-kodawari .modal_close{top:5px;font-size:2.2rem}
	#block-kodawari .modal_block .modal_contents img{width:100%;}
	#block-kodawari .modal_block .modal_ttl{padding:8px;font-size:18px;color:#fff;text-align:center;font-weight:700;background:#360;font-family:"游明朝体","Yu Mincho",YuMincho,"ヒラギノ明朝 Pro","Hiragino Mincho Pro","MS P明朝","MS PMincho",serif}
	#block-kodawari .modal_block .modal_contents{padding:25px;overflow:auto;display:block;}
	#block-kodawari .modal_block .modal_contents dl{width:100%;}
	#block-kodawari .modal_block .modal_contents dl dt{margin-top:16px;font-size:18px;font-weight:700;font-family:"游明朝体","Yu Mincho",YuMincho,"ヒラギノ明朝 Pro","Hiragino Mincho Pro","MS P明朝","MS PMincho",serif}
	#block-kodawari .modal_block .modal_contents dl dd{font-size:12px;font-family:"游明朝体","Yu Mincho",YuMincho,"ヒラギノ明朝 Pro","Hiragino Mincho Pro","MS P明朝","MS PMincho",serif;margin-top:8px}
	#block-kodawari .modal_close{cursor:pointer;position:absolute;right:10px;top:-6px;color:#fff;font-size:2rem}
	#block-kodawari .pride-wrap .txt{width:100%;float:none;margin-bottom:20px;}
	#block-kodawari .pride-wrap .map{width:100%;float:none;margin:0 0 20px;}
	#block-kodawari .pride-wrap .clear{padding-top:0;margin-top:0;}
	#block-kodawari .list_owner {margin: 0 25px 30px;}
	#block-kodawari .list_owner > li {width: 48%;}
	#block-kodawari .list_owner > li:nth-of-type(3n) {margin-right: 0;}
	#block-kodawari .list_owner > li:nth-of-type(odd) {margin-right: 3%;}
	#block-kodawari .list_owner > li:nth-of-type(even) {margin-right: 0;}
	#block-kodawari .list_owner > li:nth-of-type(n+3) {margin-top: 10px;}
	#block-kodawari .list_owner > li.award .img:before {left: 5px; top: 5px; width: 45px; height: 58.5px;}
	#block-kodawari .list_owner > li .name {font-size: 12px;}
	#block-kodawari .list_owner > li a { font-size: 10px;}
	#block-kodawari .list_owner > li a.close {font-size: 11px;}

	/* --------------------------------------------------------------- */
	/* gift */
	/* --------------------------------------------------------------- */
	#block-gift{padding:30px 0 60px;}
	#block-gift .ttl{max-width:65%;margin:0 auto 15px;}
	#block-gift .lead{font-size:10px;margin-bottom:15px;}
	#block-gift .sub-ttl{margin-bottom:30px;}
	#block-gift .sub-ttl span{font-size:16px;padding:0 15px;}
	#block-gift .list-gift{display:block;max-width:90%;margin:auto;}
	#block-gift .list-gift > li{padding:20px 25px 40px;}
	#block-gift .list-gift > li + li{margin-left:0;margin-top:20px;}
	#block-gift .list-gift > li .img{max-width:80%;margin:0 auto 15px;}
	#block-gift .list-gift > li .list-ttl{font-size:11px;margin-bottom:10px;}
	#block-gift .list-gift > li p{font-size:10px;}
	#block-gift .list-gift + .sub-ttl{margin-top:30px;}
}

@media screen and (max-width:425px){
 
.drawer-open{
 width: 55px;
 height: 45px;
 margin-top: 3px;
}
 
.drawer-open span, .drawer-open span:before, .drawer-open span:after{
 width: 40px; 
 }
 
.drawer-open span:before {
 bottom: 8px;
}
 
.drawer-open span:after {
 top: 8px;
}
 
#block-first-mother .box{
 background-size: auto 200px;
 }
 
}

@media screen and (max-width:375px){
 
.drawer-open{
 margin-top: 0px;
 margin-right: 10px;
}
 
.drawer-open span:before {
 bottom: 7px;
}
 
.drawer-open span:after {
 top: 7px;
}
 
}

/* ======================================================================================================================= */
/* for IE */
/* ======================================================================================================================= */
@media screen\0 {
	#wrapper .serif{font-family:"游明朝体","Yu Mincho",YuMincho,"ヒラギノ明朝 Pro","Hiragino Mincho Pro","MS P明朝","MS PMincho",serif;}
	#block-mv .btn a{padding-top:14px;padding-bottom:10px;}
	#block-ranking .tab-ranking > li{padding-top:14px;padding-bottom:7px;}

}
