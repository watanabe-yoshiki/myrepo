@charset "utf-8";



.home_img ul {
	position: absolute;
	right: 0;
	left: 0;
	bottom: 32px;
}


.home_img ul li a {
	display: block;
}



/* TAB */
@media screen and (min-width:768px) {
	
	.sp-img {
		display: none;
	}

	.home_img {
		position: relative;
		width: 100%;
		height: 350px;
		background: url(../img/home_pc.png) repeat center center;
		background-size: contain;
	}

	.home_img img {
		width: 100%;
		/* background: url(../img/home_pc.png);
		background-size: contain; */
	}

	.home_img ul {
		position: absolute;
		bottom: 22px;
	}

	.home_img ul li {
		position: relative;
		width: auto;
		color: #fff;
		text-align: center;
		background: rgba(0, 0, 0, 0.7);
		margin: 12px auto 0;
		padding: 4px 12px 4px 32px;
		display: table;
		vertical-align: middle;
	}

	.home_img ul li:hover {
		background: rgba(0, 0, 0, 1);
	}


	.home_img ul li a {
		color: #fff;
		font-size: 23px;
		padding-left: 0,4em;
		cursor: pointer;
	}

	.home_img ul li a::before {
		position: absolute;
		content: "";
		display: inline-block;
		left: 8px;
		width: 1em;
		height: 1em;
		background: url(../img/home_arrow.png) no-repeat;
		background-size: contain;
		margin-left: 0.3em;
		top: 9px;
	}

}

/* SP */
@media screen and (max-width:767px) {

	.pc-img {
		display: none;
	}

	.home_img {
		position: relative;
		width: 100%;
		height: 236px;
		background: url(../img/home_sp.png) no-repeat center center;
		background-size: cover;
	}

	.home_img ul {
		position: absolute;
		bottom: 20px;
	}

	.home_img ul li a {
		color: #fff;
		font-size: 13px;
	}

	.home_img ul li a::before {
		position: absolute;
		content: "";
		display: inline-block;
		left: 8px;
		width: 1em;
		height: 1em;
		background: url(../img/home_arrow.png) no-repeat;
		background-size: contain;
		margin-left: 0.3em;
		top: 7px;
	}

	.home_img ul li {
		position: relative;
		width: auto;
		color: #fff;
		text-align: center;
		background: #000000;
		margin: 6px auto 0;
		padding: 4px 8px 4px 24px;
		display: table;
		vertical-align: middle;
	}


}