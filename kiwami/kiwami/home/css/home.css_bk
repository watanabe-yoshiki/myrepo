@charset "utf-8";

#sel-wrapMainR {
    background: #fff8f3;!important
}

.wrap_white {
    background: #fff;
    padding: 20px;
}

.main_ttl {
    width: 100%;
}

.page_intro * {
    text-align: center;
    font-family: "Hiragino Mincho ProN",'Noto Serif JP',"HG明朝E","ＭＳ Ｐ明朝", serif;
}

.item_intro *{
    font-family: "Hiragino Mincho ProN",'Noto Serif JP',"HG明朝E","ＭＳ Ｐ明朝", serif;
}

.item_intro .description,dl {
    padding-left: 14px;
}

.point_home {
    position: relative;
    margin-top: 46px;
}

.point_home .point_ttl {
    position: absolute;
    top: -8px;
    left: 40px;
    padding: 4px 4px 4px 12px;
    color: #a56234;
    font-size: 16px;
    background: #fff;
    font-family: "ヒラギノ角ゴ ProN W6", "Hiragino Kaku Gothic ProN", "游ゴシック", YuGothic, "メイリオ", Meiryo, sans-serif;
}

.point_home .point_list {
    border: 1px solid #a56234;
    border-radius: 10px;
    padding: 34px 20px 20px;
}

.point_home .point_list li {
    font-family: "ヒラギノ角ゴ ProN W6", "Hiragino Kaku Gothic ProN", "游ゴシック", YuGothic, "メイリオ", Meiryo, sans-serif;
    font-size: 16px;
    font-weight: bold;
    color: #a56234;
    padding-top: 4px;
}

.point_home .point_list .check {
    display: flex;
    align-items: baseline;
}

.point_home .point_list .check::before {
    content:"";
    display:inline-block;
    width: 0.6em;
    height:0.6em;
    background:url(../images/common_home/check_list.png) no-repeat;
    background-size:contain;
    padding-right: 0.7em;
    align-items: center;
}

/* .point_home .detail_btn::after {
    content: "";
    display: inline-block;
    width: 0.6em;
    height: 0.6em;
    background: url(../images/common_home/detail_mark.png) no-repeat;
    background-size: contain;
    margin-left: 0.3em;
} */

.point_home .detail_btn span::after {
    content: "";
    display: inline-block;
    width: 5.4em;
    height: 1px;
    background: url(../images/common_home/underline.png) no-repeat;
    background-size: contain;
    position: absolute;
    bottom: -1px;
    right: 30px;
}

.point_home .detail_btn span::after:hover {
    content: "";
    display: inline-block;
    width: 5.4em;
    height: 1px;
    background: url(../images/common_home/underline.png) no-repeat;
    background-size: contain;
    position: absolute;
    bottom: -1px;
    right: 30px;
}

.section_recommend {
    margin: 0;
    padding: 24px 0 0;
}

.recommend_tl {
    font-size: 1.4em;
    font-weight: bold;
    position: relative;
    padding: 0 .4em .1em;
    z-index: 1;
}

.recommend_tl span{
    font-size: 1.4em;
    font-weight: bold;
    position: relative;
    padding: 0 .4em .1em;
    z-index: 1;
    font-family: "ヒラギノ角ゴ ProN W3", "Hiragino Kaku Gothic ProN", "游ゴシック", YuGothic, "メイリオ", Meiryo, sans-serif;
}

.section_recommend h3 {
    padding: 0;
    margin: 0 0 20px;
    font-family: "ヒラギノ角ゴ ProN W3", "Hiragino Kaku Gothic ProN", "游ゴシック", YuGothic, "メイリオ", Meiryo, sans-serif;
    font-weight: normal;
    font-size: 1em;
    text-align: center;
}

.section_recommend .comment>div {
    width: 360px;
    float: right;
}

#order {
    padding-top: 40px;
    background: #fff;
}

#order .order_list {
    padding-bottom: 80px;
}

.order_list li:first-child {
    margin-bottom: 10px;
}

.hide_contents {
    cursor: pointer;
}


@media screen and (min-width:768px) {

    .img_sp {
        display: none;
    }

    .page_intro {
        padding: 40px 0;
        text-align: center;
    }

    .page_intro h3 {
        display: inline-block;
        text-align: center;
        font-size: 30px;
        font-weight: 400;
        border-bottom: 1px solid #343434;
        margin: 0 auto;
        padding: 0 8px;
    }

    .page_intro p {
        font-size: 20px;
        padding-top: 20px;
    }

    .page_intro p span {
        display: inline;
        text-decoration: underline;
        text-decoration-style: wavy;
        text-decoration-color: #b79d86;
        padding-bottom: 3px;
    }

    .item_intro .item_img {
        margin: 0 auto;
    }

    .item_intro dl dt {
        margin-top: 40px;
        font-size: 28px;
    }

    .item_intro dl dd {
        margin-top: 20px;
        font-size: 24px;
    }

    .item_intro dl dd span {
        font-size: 14px;
    }

    .item_intro .description {
        margin-top: 32px;
        font-size: 18px;
    }



    .point_home .detail_btn {
        display: inline-block;
        text-align: right;
        font-family: "ヒラギノ角ゴ ProN W6", "Hiragino Kaku Gothic ProN", "游ゴシック", YuGothic, "メイリオ", Meiryo, sans-serif;
        font-size: 16px;
        font-weight: bold;
        color: #343434;
        padding-top: 26px;
        text-align: right;
        padding-right: 12px;
        margin-left: auto;
        opacity: 1;
    }

    .point_home div {
        width: 120px;
        margin-left: auto;
        margin-right: 0px;
    }

    .point_home .detail_btn img {
        width: 120px;
        opacity: 1;
        margin-left: auto;
        margin-right: 0px;
    }

    .point_home .detail_btn img:hover {
        width: 120px;
        opacity: 1;
    }

    .point_home .detail_btn:hover{
        transition: all .3s;
        transform: translate(5px, 0);
        opacity: 1;
    }

    .section_recommend .yellow_ttl {
        margin: 0 0 15px;
        text-align: center;
        padding-bottom: 12px;
        font-weight: bold;
        font-family: "ヒラギノ角ゴ ProN W6", "Hiragino Kaku Gothic ProN", "游ゴシック", YuGothic, "メイリオ", Meiryo, sans-serif;
    }

    .section_recommend .yellow_ttl span {
        display: inline-block;
        font-size: 18px;
        font-weight: bold;
        position: relative;
        padding: 0 .4em .1em;
        z-index: 1;
    }

    .section_recommend .yellow_ttl span::after {
        content: '';
        display: block;
        position: absolute;
        bottom: 0;
        left: 0;
        z-index: -1;
        width: 100%;
        height: 10px;
        background: rgba(255, 255, 48, 0.3);
    }

    #order .yellow_ttl {
        margin: 0 0 15px;
        text-align: center;
        padding-bottom: 12px;
        font-weight: bold;
        font-family: "ヒラギノ角ゴ ProN W6", "Hiragino Kaku Gothic ProN", "游ゴシック", YuGothic, "メイリオ", Meiryo, sans-serif;
    }

    #order .yellow_ttl span {
        display: inline-block;
        font-size: 18px;
        font-weight: bold;
        position: relative;
        padding: 0 .4em .1em;
        z-index: 1;
    }

    #order .yellow_ttl span::after {
        content: '';
        display: block;
        position: absolute;
        bottom: 0;
        left: 0;
        z-index: -1;
        width: 100%;
        height: 10px;
        background: rgba(255, 255, 48, 0.3);
    }

    #order .grad-btn {
        z-index: 2;
        position: absolute;
        right: 0;
        bottom: -64px;
        left: 0;
        width: 148px;
        margin: auto;
        padding: .5em 0;
        color: #343434;
        font-size: 16px;
        text-align: center;
        cursor: pointer;
        transition: .2s ease;
        padding-bottom: 12px;
        font-weight: bold;
        font-family: "ヒラギノ角ゴ ProN W6", "Hiragino Kaku Gothic ProN", "游ゴシック", YuGothic, "メイリオ", Meiryo, sans-serif;
    }

    .grad-btn::after {
        content: "";
        display: inline-block;
        width: 4.4em;
        height: 1px;
        background: url(../images/common_home/underline.png) no-repeat;
        background-size: contain;
        margin-left: 0.3em;
        position: absolute;
        top: 36px;
        right: 43px;
    }

    #order {
        padding-left: 20px;
        padding-right: 20px;
    }

    .item_button {
        padding-top: 24px;
        text-align: center;
        width: 104px;
        margin: 0 auto;
    }

    .item_button:hover {
        transition: all .3s;
        transform: translate(0, 5px);
    }

    #main_end {
        width: 100%;
        height: 160px;
        background: url(../images/common_home/home_ft_pc.png) no-repeat center center;
        background-size: cover;
        ;
    }

    #main_end p {
        padding-top: 20px;
        font-size: 18px;
        color: #fff;
        font-family: "Hiragino Mincho ProN", 'Noto Serif JP', "HG明朝E", "ＭＳ Ｐ明朝", serif;
        text-align: center;
        line-height: 1.8;
        letter-spacing: 0.1em;
    }

    #main_end ul {
        display: -webkit-flex;
        display: flex;
        -webkit-justify-content: center;
        justify-content: center;
        -webkit-align-items: baseline;
        align-items: baseline;
	}

    #main_end ul li {
        background: #fff8f3;
        font-weight;
        bold;
        font-family: "ヒラギノ角ゴ ProN W6", "Hiragino Kaku Gothic ProN", "游ゴシック", YuGothic, "メイリオ", Meiryo, sans-serif;
        text-align: center;
        margin: 12px 6px 0;
        border: 1px solid #000;
    }

    #main_end ul li a {
        position: relative;
        display: block;
        padding: 8px 42px 6px;
    }

    #main_end ul li:hover {
        background: #fff;
        transition: all .3s;
    }

    #main_end ul li a::after {
        position: absolute;
        content: "";
        display: inline-block;
        right: 0;
        width: 0.8em;
        height: 0.8em;
        background: url(../images/common_home/ft_mark.png) no-repeat;
        background-size: contain;
        margin-left: 0.3em;
        top: 12px;
        right: 8px;
    }
}

@media screen and (max-width:767px) {

    .img_pc {
        display: none;
    }

    .wrap_white {
        background: #fff;
        padding: 4%;
    }

    .wrap_orange {
        background: #fff8f3;
        padding: 4%;
    }

    /* #sel-wrapper #main_tl {
        padding-top: 65px;
    } */

    .page_intro {
        padding: 36px 0;
    }

    .page_intro h3 {
        display: block;
        width: 72%;
        font-size: 18px;
        font-weight: 400;
        border-bottom: 1px solid #343434;
        margin: 0 auto;
    }

    .page_intro p {
        font-size: 14px;
        padding-top: 20px;
        line-height: 1.8;
    }

    .page_intro p span {
        display: inline;
        text-decoration: underline;
