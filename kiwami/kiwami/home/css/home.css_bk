        opacity: 1;
    }

    .point_home .detail_btn:hover{
        transition: all .3s;
        transform: translate(5px, 0);
        opacity: 1;
    }

    .section_recommend .yellow_ttl {
        margin: 0 0 15px;
        text-align: center;
        padding-bottom: 12px;
        font-weight: bold;
        font-family: "ヒラギノ角ゴ ProN W6", "Hiragino Kaku Gothic ProN", "游ゴシック", YuGothic, "メイリオ", Meiryo, sans-serif;
    }

    .section_recommend .yellow_ttl span {
        display: inline-block;
        font-size: 14px;
        font-weight: bold;
        position: relative;
        padding: 0 .4em .1em;
        z-index: 1;
    }

    .section_recommend .yellow_ttl span::after {
        content: '';
        display: block;
        position: absolute;
        bottom: 0;
        left: 0;
        z-index: -1;
        width: 100%;
        height: 10px;
        background: rgba(255, 255, 48, 0.3);
    }

    .section_recommend .comment>div {
        float: none;
        width: 100%;
    }

    .section_recommend .comment>div .ttl {
        font-size: 13px;
        margin-top: 4px;
    }

    .section_recommend .comment>div .name {
        font-size: 12px;
        margin-top: 4px;
    }

    #order .yellow_ttl {
        margin: 0 0 15px;
        text-align: center;
        padding-bottom: 12px;
        font-weight: bold;
        font-family: "ヒラギノ角ゴ ProN W6", "Hiragino Kaku Gothic ProN", "游ゴシック", YuGothic, "メイリオ", Meiryo, sans-serif;
    }

    #order .yellow_ttl span {
        display: inline-block;
        font-size: 14px;
        font-weight: bold;
        position: relative;
        padding: 0 .4em .1em;
        z-index: 1;
    }

    #order .yellow_ttl span::after {
        content: '';
        display: block;
        position: absolute;
        bottom: 0;
        left: 0;
        z-index: -1;
        width: 100%;
        height: 10px;
        background: rgba(255, 255, 48, 0.3);
    }

    .order_list li .order_list_info p:nth-child(-n+3) {
        font-size: 12px;
    }

    #order .grad-btn {
        z-index: 2;
        position: absolute;
        right: 0;
        bottom: -64px;
        left: 0;
        width: 148px;
        margin: auto;
        padding: .5em 0;
        color: #343434;
        font-size: 14px;
        text-align: center;
        cursor: pointer;
        transition: .2s ease;
        padding-bottom: 12px;
        font-weight: bold;
        font-family: "ヒラギノ角ゴ ProN W6", "Hiragino Kaku Gothic ProN", "游ゴシック", YuGothic, "メイリオ", Meiryo, sans-serif;
    }

    .grad-btn::after {
        content: "";
        display: inline-block;
        width: 4.4em;
        height: 1px;
        background: url(../images/common_home/underline.png) no-repeat;
        background-size: contain;
        margin-left: 0.3em;
        position: absolute;
        top: 32px;
        right: 47px;
    }

    .order_list li .order_list_thumb {
        width: 150px;
    }

    .order_list li {
        width: 100%;
        margin-top: 10px;
        padding: 20px;
        border-top: #CCC 1px solid;
        border-bottom: #CCC 1px solid;
        border-left: none;
        border-right: none;
        position: relative;
    }

    .order_list_info .name,.price,.capacity {
        font-size: 12px !important;
    }

    .item_button {
        padding-top: 36px;
        text-align: center;
        width: 104px;
        margin: 0 auto;
    }

    #main_end {
        width: 100%;
        height: 218px;
        background: url(../images/common_home/home_ft_sp.png) no-repeat center center;
        background-size:cover;
        ;
    }

    #main_end p {
        padding-top: 20px;
        font-size: 12px;
        color: #fff;
        font-family: "Hiragino Mincho ProN",'Noto Serif JP',"HG明朝E","ＭＳ Ｐ明朝", serif;
        text-align: center;
        line-height: 1.8;
        letter-spacing: 0.1em;
    }

    #main_end ul li {
        position: relative;
        width: 80%;
        padding: 8px;
        background: rgb(255, 255, 255, 0.8);
        font-weight;
        bold;
        font-family: "ヒラギノ角ゴ ProN W6", "Hiragino Kaku Gothic ProN", "游ゴシック", YuGothic, "メイリオ", Meiryo, sans-serif;
        text-align: center;
        margin: 12px auto 0;
        border: 1px solid #000;
    }

    #main_end ul li::after {
        position: absolute;
        content: "";
        display: inline-block;
        right: 0;
        width: 0.8em;
        height: 0.8em;
        background: url(../images/common_home/ft_mark.png) no-repeat;
        background-size: contain;
        margin-left: 0.3em;
        top: 11px;
        right: 8px;
    }
}

