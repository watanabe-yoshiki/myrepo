//UserAgent
var ua;
var isViewSP = false;
var isAndroid = false;
var SP_BREAK_POINT = 599; // スマホブレイクポイント
var Y;
$(document).ready(function(){
  /**
   * Detect os and browser
   **/
  if ( Detect.sp() ) {
    ua = "SP";
    isViewSP = true;
    $("body").addClass("sp");

    if ( Detect.os() == "ipod" || Detect.os() == "iphone" ) {
      $("body").addClass("iphone");
    } else if ( Detect.os() == "android mobile" ) {
      isAndroid = true;
      $("body").addClass("android");
    }

    if ( Detect.ios() ) {
      $("body").addClass("ios");
    }
  } else if ( Detect.tablet() ) {
    ua = "TABLET";
    $("body").addClass("tablet");
  } else {
    if( window.innerWidth <= SP_BREAK_POINT ){
      isViewSP = true;
    } else {
      isViewSP = false;
    }
    $("body").addClass( Detect.os() ).addClass( Detect.browser() );
  }
});

/* ----------------------------------------
 * MV
 * ------------------------------------- */

$(function(){
	var VI_S_h = $('.vi .vi-img .figure_01').height();
	var VI_S_w = $('.vi .vi-img .figure_01').width();
	var VI_C_h = $('.vi .vi-img .figure_03').height();
	var VI_C_w = $('.vi .vi-img .figure_03').width();

	var $clone_vi_slide = $('.vi-slider').clone();
  $clone_vi_slide.appendTo('.vi .vi-img .figure');//スライダー中身コピー

	/* VIの各ブロックの長さと幅を取得して設定 */
	$(".vi .vi-img .figure_01 figure,.vi .vi-img .figure_02 figure,.vi .vi-img .figure_04 figure,.vi .vi-img .figure_05 figure").css({ width:VI_S_w, height:VI_S_h});
	$(".vi .vi-img .figure_03 figure").css({ width:VI_C_w, height:VI_C_h});
	
});

/* VIスライダー動き */
(function($) {
    $.fn.sliders = function(){

        var slideChangeTime = 1500;
        var slideShowTime = 4000;

       	var slideWrap = this;
        var own = slideWrap.attr('id')
        var slideContent = slideWrap.find('ul');
        var slideList = slideContent.find('li');
        var slideWidth = slideList.find('figure').width();
        var slideHeight = slideList.find('figure').height();
        var slideNum  = slideList.length;

        //全体を囲む
        this.wrapInner('<div class="sliders"></div>');
        var slideWrapInner = slideWrap.children($('.sliders'));

        //それぞれ実行
        moveOn();

        function moveOn() {

            slideWrapInner.css({
                'margin-right': 'auto',
                'margin-left': 'auto',
                'position': 'relative',
                'overflow' : 'hidden',
                'width' : slideWidth,
                'height' : slideHeight
            });
            slideContent.css({
                'overflow' : 'hidden',
                'width' : (slideList.width() * slideNum)
            });

            slideList.css({
                'position' : 'absolute',
                'left': slideWidth,
                'z-index': 3
            });

            slideList.eq(0).css({
                'left': 0,
                'z-index': 1
            });

            var index = 1;//次表示
            var currentIndex = 0;//現在表示

            function goSlide(index){

                //現在表示中
                slideList.eq(currentIndex).addClass('exit-slide').removeClass('next-slide').css('z-index', 1);

                //真ん中に動く
                slideList.eq(index).addClass('next-slide').removeClass('exit-slide').stop().animate({
                    'left': 0
                },slideChangeTime,'easeInQuint',function(){
                    slideList.eq(currentIndex).stop().animate({
                        'left': slideWidth,
                        'z-index': 3
                    },0,function(){
                        currentIndex　= index;
                    });
                });
            }

            function start(){
                own = setInterval(function() {
                        clickFlg = false;
                        goSlide(index)
                        index++;
                        if(index == slideNum){
                            index = 0;
                        }
                    }, slideShowTime);
            }

            function stop () {
               clearInterval(own);
            }

            start();
        }

    }

})(jQuery);
/* VIスライダー動き-おわり */

/* ----------------------------------------
 * intro
 * ------------------------------------- */
$(function() {
	
	//intro
	if($.cookie("access") == 1) {
		/*$(".vi .vi-img .figure_01 .vi-slider").sliders();
		$(".vi .vi-img .figure_02 .vi-slider").sliders();
		$(".vi .vi-img .figure_03 .vi-slider").sliders();
		$(".vi .vi-img .figure_04 .vi-slider").sliders();
		$(".vi .vi-img .figure_05 .vi-slider").sliders();*/
		$('#top-mv .slider').slick({ autoplay:true, speed:3000, fade:true, arrows:false, });
	} else {
		//loading
		var progress = 0;
		var imgCount = $('img').length;
		$("img").each(function(){
			 var src = $(this).attr('src');
			 $("<img>").attr('src',src).on('load',function(){
				 progress++;
			 });
		});
		setInterval(function(){
			 $("#gauge").css({
				 'width': (progress / imgCount) * 100 + '%'
			 });
		}, 1);
		
		//loading-end
		$(window).on('load',function(){
			setTimeout(function() {
				/*$(".vi .vi-img .figure_01 .vi-slider").sliders();
				$(".vi .vi-img .figure_02 .vi-slider").sliders();
				$(".vi .vi-img .figure_03 .vi-slider").sliders();
				$(".vi .vi-img .figure_04 .vi-slider").sliders();
				$(".vi .vi-img .figure_05 .vi-slider").sliders();*/
				$('#top-mv .slider').slick({ autoplay:true, speed:3000, fade:true, arrows:false, });
			}, 1000);
			$('#intro').delay(1000).fadeOut(1000);
			$.cookie("access","1");
		});
	}
});


/* ----------------------------------------
 * feature
 * ------------------------------------- */
function sliderSetting(){
	var width = $(window).width();
	if(width > 600){
		$('.feature-list').not('.slick-initialized').slick({
			autoplay:true,
			speed: 500,
			autoplaySpeed:2500,
			infinite: true,
			slidesToShow: 3,
			slidesToScroll: 1,
		});
	}else if(width <= 599){
		$('.feature-list').not('.slick-initialized').slick({
			autoplay:true,
			speed: 500,
			autoplaySpeed:2500,
			infinite: true,
			slidesToShow: 2,
			slidesToScroll: 2,
		});
	} else {
		$('.feature-list.slick-initialized').slick('unslick');
	}
}
$(function(){
	sliderSetting();
	$(window).resize( function() {
		sliderSetting();
	});
});


/* ----------------------------------------
 * product-slider
 * ------------------------------------- */
/*main-sliderコピーしてsub-sliderに*/
$('#product-slider .main-slider ul').each(function() {
		var $clone_product_slide = $(this).clone();
		$clone_product_slide.appendTo($(this).parent().parent().find(".sub-slider"));/*sub-sliderの一番最初のスライドを最後にする（次の画像っぽくするためずらす）*/
		var $sub_slider = $(this).parent().parent().find(".sub-slider ul");
		$sub_slider.each(function() {
			$('li:first-of-type', this).appendTo(this);
		});

	$(this).slick({
			asNavFor:$sub_slider,
			autoplay:true,
			fade:true,
			speed: 500,
			autoplaySpeed:3000,
			arrows:false,
	});
	$sub_slider.slick({
			asNavFor:$(this),
			autoplay:true,
			fade:true,
			speed: 500,
			autoplaySpeed:3000,
			arrows:false,
	});
	$(this).parent().on('click',function(){
			$(this).slick('slickNext');
	});
	$sub_slider.parent().on('click',function(){
			$(this).slick('slickNext');
	});
});


/* ----------------------------------------
 * move_text
 * ------------------------------------- */
$(function () {
  $('#product-slider .product-slider-sec:nth-of-type(odd) .move_text').each(function () {
    var $win = $(window),
        $winH = $win.height(),
        $connect = $(this),
        position = $connect.offset().top,
        current = 0,
		scroll;

    $win.on('load scroll', function () {

      scroll = $win.scrollTop();
      //current = (1 - (position - scroll) / $winH) * 2 * 100;
	  	current = scroll - position * 2;

      if (current > 99.9) {
        current = 100;
      }
      if (scroll > position - $winH) {
        //$connect.css({right: current + '%'});
		$connect.css({"transform": "translate3d( " + current + "px, 0px, 0px)"});
      }
    });
  });
	//逆に動く
	$('#product-slider .product-slider-sec:nth-of-type(even) .move_text').each(function () {
    var $win = $(window),
        $winH = $win.height(),
        $connect = $(this),
        position = $connect.offset().top,
        current = 0,
		scroll;

    $win.on('load scroll', function () {

      scroll = $win.scrollTop();
	  	current = position - scroll *2; //ここだけ違う

      if (current > 99.9) {
        current = 100;
      }
      if (scroll > position - $winH) {
        //$connect.css({right: current + '%'});
		$connect.css({"transform": "translate3d( " + current + "px, 0px, 0px)"});
      }
    });
  });
});


/* ----------------------------------------
 * リサイズしたらリロード
 * ------------------------------------- */

$(function(){
    var timer = false;
    var prewidth = $(window).width()
    $(window).resize(function() {
        if (timer !== false) {
            clearTimeout(timer);
        };
        timer = setTimeout(function() {
            var nowWidth = $(window).width()
            if(prewidth !== nowWidth){
                location.reload();
            };
            prewidth = nowWidth;
        }, 200);
    });
});


/* ------------------------------------------------------ */
/* アニメーション禁止 */
