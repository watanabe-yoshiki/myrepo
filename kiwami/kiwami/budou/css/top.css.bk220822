@charset "utf-8";

* {
    letter-spacing: 0.1em;
}

.clearfix {
    clear: both;
}

.notice {
    position: relative;
    padding: 15px;
    color: #fff;
    text-align: center;
    background-color: #d08e29;
    z-index: 99;
    cursor: pointer;
}

#sel-wrapMainR {
    background: none;
    padding: 0;
    overflow:hidden;
    width: 100%;
}

#sel-containerA {
    width: 100%;
}

#sel-wrapper {
    padding: 0;
}

.header-nav .nav-main .tokusyu {
    display: block;
    box-sizing: border-box;
    text-align: center;
    background: #e8462e;
}

.header-nav .nav-main .tokusyu a {
    display: block;
    color: #fff;
    font-weight: 700;
    letter-spacing: .02em;
    width: 100%;
    height: 100%;
    padding: .7em 20px .7em 20px;
    box-sizing: border-box;
    position: relative;
}

.header-nav .nav-main .tokusyu a:hover {
    background: #e27c6c;
}


.mv .inner a:hover,
.wrapper .rank .inner a:hover,
.wrapper .comments .inner a:hover,
.wrapper .recommended .inner a:hover,
.wrapper .kodawari .inner a:hover {
    opacity: .7;
    transition: .2s;
}

.mv .inner {
    position: relative;
    text-align: center;
}

.mv .inner p {
    font-size: 18px;
    color: #fff;
    text-shadow:4px 4px 4px rgba(0, 0, 0, .5);
}

.mv .inner .item_all,.all_items .item_all {
    display: inline-block;
    font-size: 18px;
    text-align: center;
    color: #fff;
    margin: 16px 0 8px;
    padding: 10px 30px;
    background: rgba(95, 38, 108, 1);
    box-shadow: 0px 4px 6px 0px rgba(0, 0, 0, .5);
    font-family: "ヒラギノ明朝 ProN W6", "HiraMinProN-W6", "HG明朝E", "ＭＳ Ｐ明朝", "MS PMincho", "MS 明朝", serif;
    letter-spacing: 0.1em;
}

.mv .inner .item_all.close {
    background-color: #666;
    pointer-events: none;
}

.mv .inner ul li {
    position: relative;
    font-size: 16px;
    text-align: center;
    color: #000;
    margin: 16px 12px 8px;
    background: rgba(255, 255, 255, .8);
    box-shadow: 0px 4px 6px 0px rgba(0, 0, 0, .5);
    font-family: "ヒラギノ明朝 ProN W6", "HiraMinProN-W6", "HG明朝E", "ＭＳ Ｐ明朝", "MS PMincho", "MS 明朝", serif;
    letter-spacing: 0.1em;
}

.mv .inner ul li a {
    display: block;
    padding: 10px 30px;
}

.mv .inner .pickup {
    position: absolute;
    content: "";
    background: url("../images/top/pickup.png")no-repeat;
    top: -20px;
    left: -20px;
    width: 72px;
    height: 72px;
}

.mv .inner .main_btn {
    position: absolute;
}


.wrapper .bnr_area ul {
    display: flex;
}

.wrapper .bnr_area li {
    flex: 1;
    text-align: center;
}

.wrapper .bnr_area li+li {
    margin-left: 20px;
}

.wrapper p,dd {
    line-height: 1.8;
}

.bg_white {
    position: relative;
}

.wrapper .news {
    position: relative;
    background: #333333;
}

.contact {
    position: relative;
    background: #fff;
}

.rank {
    position: relative;
    background: #fff;
}

.comments {
    position: relative;
    background: #666633;
}

.recommended {
    position: relative;
    background: #fff;
}

.kodawari {
    position: relative;
    background: #666633;
}

.comments * {
    color: #fff;
}

.kodawari * {
    color: #fff;
}

.producer {
    position: relative;
    background: #666633;
}
.producer * {
    color: #fff;
}


/* .wrapper:nth-of-type(n+2) {
    margin-top: 20px;
} */

.wrapper h3 {
    text-align: center;
    font-weight: 400;
    letter-spacing: 2px;
    position: relative;
    display: flex;
    align-items: center;
	font-size: 27px;
}

.wrapper h4 {
    text-align: center;
    font-weight: 400;
    letter-spacing: 2px;
    position: relative;
    align-items: center;
    color: #000;
    font-size: 27px;
    font-family: "ヒラギノ明朝 ProN W6", "HiraMinProN-W6", "HG明朝E", "ＭＳ Ｐ明朝", "MS PMincho", "MS 明朝", serif;
}

.inner .sub_ttl {
    color: #5f266c;
    font-size: 18px;
    letter-spacing: 0.1em;
    text-align: center;
}

.wrapper h3:before {
	margin-right: 0.6em;
}
.wrapper h3:after {
	margin-left: 0.6em;
}

.wrapper h3:before,
.wrapper h3:after {
    content: "";
    flex-grow: 1;
    height: 1px;
    background: #444;
    display: block;
}

.wrapper .comments h3:before,
.wrapper .kodawari h3:before,
.wrapper .producer h3:before {
    content: "";
    flex-grow: 1;
    height: 1px;
    background: #fff;
    display: block;
}

.wrapper .comments h3:after,
.wrapper .kodawari h3:after,
.wrapper .producer h3:after {
    content: "";
    flex-grow: 1;
    height: 1px;
    background: #fff;
    display: block;
}

.kodawari dl dt {
    /* font-weight: bold; */
    font-family: "ヒラギノ明朝 ProN W4", "HiraMinProN-W4", "HG明朝E", "ＭＳ Ｐ明朝", "MS PMincho", "MS 明朝", serif;
}

.wrapper .comments h3,
.kodawari h3,
.producer h3 {
    font-family: 'Hiragino Kaku Gothic Pro','ヒラギノ角ゴ Pro W4','メイリオ',Meiryo,'ＭＳ Ｐゴシック',sans-serif;
    color: #fff;
}

.comments .inner ul li img {
    /* border-radius: 50%; */
}

.wrapper .comments ul li dl {
    width: 100%;
    clear: both;
}

.wrapper .comments ul li dl dd {
    position: relative;
    font-size: 14px;
    margin-top: 16px;
    padding: 10px 0 0 16px;
}

.wrapper .comments ul li dl dd:before {
    position: absolute;
    background: url("../images/top/kakko.png") no-repeat;
    content: "";
    top: 0;
    left: 0;
    height: 56px;
    width: 56px;
}

.wrapper .comments ul li dl dd span {
    display: block;
    text-align: right;
}

.wrapper .comments ul li dl a {
    float: right;
    font-size: 14px;
    margin-top: 8px;
    border-bottom: 1px solid #fff;
    padding-bottom: 2px;
}

.wrapper .rank .inner p {
    font-size: 14px;
}

.wrapper .rank .inner ul figure {
    text-align: left;
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 99;
}

.wrapper .rank .inner ul figure img {
    width: 38px;
    height: 38px;
}

.wrapper .rank .inner ul figure .rank12 {
    width: 46px;
    height: 46px;
}

.wrapper .rank .inner ul dl {
  display: flex;
  flex-direction: column;
  position: relative;
}

.wrapper .rank .inner ul dl dt {
    border: 1px solid #e5e5e5;
}

.wrapper .rank .inner ul dl dd {
    margin-top: 12px;
    padding: 0 2px;
    font-size: 12px;
    text-align: left;
    line-height: 1.5;
    font-family: 'Hiragino Kaku Gothic Pro','ヒラギノ角ゴ Pro W6','メイリオ',Meiryo,'ＭＳ Ｐゴシック',sans-serif;
}

.wrapper .rank .inner ul dl .price {
    margin-top: auto;
    padding: 6px 0 0;
    font-size: 14px;
    text-align: right;
    font-weight: bold;
    color: #000;
}

.wrapper .rank .inner ul dl .item_name {
    font-size: 14px;
    /* font-weight: bold; */
}

.wrapper .rank .inner ul li.soldout dt {
    position: relative;
	background: #fff;
}
.wrapper .rank .inner ul li.soldout dt img {
    opacity: .4;
}
.wrapper .rank .inner ul li.soldout dt:before {
    content: "販売終了";
    position: absolute;
    top: 50%;
    left: 50%;
    display: inline-block;
    width: 7em;
    height: 1.5em;
    margin: -1em 0 0 -4.25em;
    padding: .5em;
    background: #9b8239;
    border: solid 2px #fff;
    color: #fff;
    line-height: 1.5;
	letter-spacing: .1em;
    font-family: 'Hiragino Kaku Gothic Pro','ヒラギノ角ゴ Pro W6','メイリオ',Meiryo,'ＭＳ Ｐゴシック',sans-serif;
    font-size: 1rem;
	z-index: 1;
}

.wrapper .recommended .desc dl {
    position: relative;
}

.wrapper .recommended .desc dl dt {
    color: #000;
}

.wrapper .recommended .desc dl img{
    position: absolute;
    top: 0;
    right: 0;
}

.wrapper .recommended .desc p {
    color: #666666;
}

.wrapper .recommended .item1 .desc {
    border-top: 6px solid #99cc33;
}

.wrapper .recommended .item2 .desc {
    border-top: 6px solid #5f266c;
}

.wrapper .recommended .desc .desc_img figcaption {
    margin-top: 8px;
    text-align: left;
    color: #666666;
}

.wrapper .recommended .desc .order_btn {
    display: table;
    font-size: 16px;
    padding: 8px 36px;
    text-align: center;
    letter-spacing: 0.1em;
    margin: 24px auto 0;
}

.wrapper .recommended .desc .order_btn.green {
    background: #fff;
    border: 1px solid #99cc33;
    color: #99cc33;
}

.wrapper .recommended .desc .order_btn.green:hover {
    background: #99cc33;
    color: #fff;
    opacity: 1;
}

.wrapper .recommended .desc .order_btn.purple {
    background: #fff;
    border: 1px solid #5f266c;
    color: #5f266c;
}

.wrapper .recommended .desc .order_btn.purple:hover {
    background: #5f266c;
    color: #fff;
    opacity: 1;
}
.wrapper .recommended .desc .order_btn.close {
    border: 1px solid #666;
    color: #666;
    pointer-events: none;
}

.wrapper .recommended .desc .order_other {
    display: table;
    color: #666666;
    font-size: 14px;
    margin: 16px auto 0;
    padding-bottom: 3px;
    /* border-bottom: 1px solid #666666; */
    letter-spacing: 0.1em;
    text-decoration: underline;
    text-align: center;
}

.wrapper .recommended .desc .item_img.is-sp {
    position: relative;
    margin: 32px auto 0;
    width: 70%;
}

.wrapper .recommended .quantity {
    position: absolute;
    top: -16px;
    left: -20%;
    font-size: 14px;
    padding: 3px 12px;
    border: 1px solid #ff0033;
    color: #ff0033 !important;
    background: #fff;
}

.wrapper .recommended .desc .desc_img {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-wrap: nowrap;
    flex-wrap: nowrap;
    -webkit-justify-content: center;
    justify-content: center;
    margin-top: 40px;

}

.wrapper .recommended .desc .desc_img figure:nth-child(2) {
    margin-left: 12px;
}

.wrapper .kodawari .kodawari_block {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-wrap: nowrap;
    flex-wrap: nowrap;
    -webkit-justify-content: flex-start;
    justify-content: flex-start;
}

.wrapper .popular .hinsyu {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-wrap: wrap;
    flex-wrap: wrap;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    -webkit-align-items: flex-start;
    align-items: flex-start;
    -webkit-align-content: flex-start;
    align-content: flex-start;
}
.wrapper .popular .tbl_box-soldOut {
    position: relative;
}
.wrapper .popular .tbl_box-soldOut:before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: rgba(255,255,255,0.6);
    z-index: 100;
}
.wrapper .popular .tbl_box-soldOut:after {
    content: "販売終了";
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translateY(-50%) translateX(-50%);
    -webkit-transform: translateY(-50%) translateX(-50%);
    padding: 5px 20px;
    color: #fff;
    background: #000;
    z-index: 101;
}
.wrapper .popular .tbl_box-soldOut a {
    pointer-events: none;
}

.wrapper .popular .hinsyu .tbl.green {
    border-top: 6px solid #99cc33;
}

.wrapper .popular .hinsyu .tbl.purple {
    border-top: 6px solid #5f266c;
}

.wrapper .popular .tbl_b .tbl_box:before {
    content: "";
    display: block;
    height: 6px;
    width: 100%;
    margin-bottom: 20px;
    background: -webkit-gradient(linear, left top, right bottom, from(#99cc33), to(#5f266c));
    background: -moz-linear-gradient(left, #99cc33, #5f266c);
    background: linear-gradient(left, #99cc33, #5f266c);
}

.wrapper .popular .tbl_b .tbl_box-soldOut:before {
    height: 100%;
    background: rgba(255,255,255,0.6);
}

.wrapper .popular .tbl_box {
    margin-top: 20px;
    position: relative;
    text-align: center;
    /* color: #fff; */
    /* background: gray; */
}

.wrapper .popular .tbl_box p {
    position: absolute;
    color: #fff;
    top: 0;
    left: 0;
    width: 60px;
    height: 60px;
    /* font-size: 12px;
    text-align: left; */
    z-index: 99;
}

.wrapper .popular .tbl_box dl {
    position: absolute;
    color: #fff;
    right: 0;
    bottom: 16px;
    left: 0;
    z-index: 99;
}

.wrapper .popular .tbl_box dl dt {
    font-weight: bold;
    font-family: 'Hiragino Kaku Gothic Pro','ヒラギノ角ゴ Pro W6','メイリオ',Meiryo,'ＭＳ Ｐゴシック',sans-serif;
    line-height: 1.4;
}

.wrapper .popular .tbl_box dl dd {
    font-size: 16px;
    margin-top: 4px;
}

.wrapper .popular .hinsyu .col_l {
    float: left;
    width: 48%;
    /* height: 238px; */
}

.wrapper .popular .hinsyu .col_r {
    float: right;
    width: 48%;
    /* height: 238px; */
}

.wrapper .popular .hinsyu .col_c {
    float: right;
    width: 100%;
    /* height: 238px; */
}

.wrapper .producer ul {
    display: flex;
    flex-wrap: wrap;
}

.wrapper .popular .hinsyu dl {
    width: 100%;
}

.wrapper .popular .tbl_b {
    width: 100%;
    padding-bottom: 40px;
}

.pagetop_btn .inner {
    text-align: center;
    margin: 40px 0;
}

.pagetop_btn .inner a {
    padding: 16px 24px;
    color: #fff;
    background: #000;
    border: 1px solid #000;
    font-size: 18px;
    text-align: center;
    font-family: "ヒラギノ明朝 ProN W6", "HiraMinProN-W6", "HG明朝E", "ＭＳ Ｐ明朝", "MS PMincho", "MS 明朝", serif;
}

.pagetop_btn .inner a:before {
    content: "";
    display: inline-block;
    width: 10px;
    height: 14px;
    margin: -3px 8px 0 0px;
    background: url("../images/arrow_back.png") no-repeat;
    background-size: contain;
    vertical-align: middle;
}

.pagetop_btn .inner a:hover {
    opacity: .6;
}

.wrapper .producer li.fair {
    position: relative;
}

.wrapper .producer li.fair:before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    background: url("../images/top/award.png") left top / 100% auto no-repeat;
}

@-webkit-keyframes slideRightBg {
    0% {
        opacity: 0;
        left: -50%;
    }

    100% {
        opacity: 1;
        left: 0;
    }
}

@keyframes slideRightBg {
    0% {
        opacity: 0;
        left: -50%;
    }

    100% {
        opacity: 1;
        left: 0;
    }
}


.all_items .inner {
  text-align: center;
}

@media screen and (min-width:768px) {

    #sel-wrapMainR {
        background: none;
        padding-top: 0;
    }

    .is-pc {
        display: block;
    }

    .is-tab {
        display: block;
    }

    .is-sp {
        display: none;
    }

    .img_sp {
        display: none;
    }

    .mv {
        background: url("../images/top/mv.png") center center no-repeat;
        background-size: cover;
        height: 362px;
    }

    .mv .inner h2 {
        text-align: center;
    }

    .mv .inner h2 img{
        width: 540px;
        padding-top: 60px;
    }

    .mv .inner div>a img {
    width: 400px;
    }

    .mv .inner ul {
        max-width: 768px;
        margin: 0 auto;
        display: -webkit-flex;
        display: flex;
        -webkit-justify-content: center;
        justify-content: center;
    }

    .mv .inner ul li {
        width: 50%;
    }

    .mv .inner .main_btn {
        width: 200px;
        bottom: -50px;
        right: 0;
    }

    .wrapper h3 img {
        height: 24px;
    }

    section {
        padding: 40px 0 64px;
    }

    .wrapper .news {
        padding: 12px 0;
    }

    .wrapper .contact {
		padding-top: 20px;
		padding-bottom: 20px;
    }

    .wrapper .rank .inner ul li {
        width: 184px;
        text-align: center;
    }

    .wrapper .rank .inner ul {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        margin-top: 8px;
    }

    .wrapper .rank .inner li {
        margin-top: 28px;
    }

    .wrapper .rank .inner>p {
        text-align: center;
        margin-bottom: 8px;
    }

    .wrapper .rank .inner ul dl .item_name {
        /* height: 76px; */
    }

    .wrapper .rank .inner>p img {
        width: 36px;
    }

    .wrapper .size .size_wrap {
        display: flex;
        justify-content: space-between;
        -webkit-align-items: flex-start;
        align-items: flex-end;
    }

    .wrapper .size {
        padding-top: 40px;
    }

    .wrapper .size_left {
        width: 50%;
    }

    .wrapper .size_left p {
        font-size: 14px;
    }

    .wrapper .size_left dl {
        position: relative;
        background: #CBCBCB;
        margin-top: 24px;
    }

    .wrapper .size_wrap>img {
        width: 46%;
    }

    .wrapper .size_left dl dt {
        font-size: 18px;
        font-weight: bold;
        color: #fff;
        font-family: "ヒラギノ明朝 ProN W6", "HiraMinProN-W6", "HG明朝E", "ＭＳ Ｐ明朝", "MS PMincho", "MS 明朝", serif;
        padding: 8px 14px 8px 28px;
        background: #000000;
        text-align: left;
    }

    .wrapper .size_left dl dd {
        padding-top: 14px;
        font-size: 14px;
        font-family: "ヒラギノ明朝 ProN W6", "HiraMinProN-W6", "HG明朝E", "ＭＳ Ｐ明朝", "MS PMincho", "MS 明朝", serif;
        padding: 14px;
        text-align: left;
    }

    .wrapper .comments .inner {
        text-align: center;
    }

    .wrapper .kodawari .producer>p {
        display: inline-block;
        margin: 20px 16px 12px;
        text-align: left;
        font-size: 14px;
    }

    .wrapper .kodawari .producer {
        background: #fff;
        margin-top: 32px;
        padding-bottom: 32px;
    }

    .wrapper .kodawari .pride {
        background: #fff;
        margin-top: 32px;
        padding-bottom: 32px;
    }

    .wrapper .kodawari .pride>p {
        padding: 0 20px;
    }

    .wrapper .kodawari .pride .pride_wrap {
        margin-top: 20px;
        padding: 0 20px;
    }

    .wrapper .comments .inner>p {
        display: inline-block;
        margin: 20px auto;
        text-align: left;
        font-size: 14px;
    }

    .wrapper .comments ul {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        -webkit-align-items: flex-start;
        align-items: flex-start;
        text-align: left;
    }

    .wrapper .comments ul li {
        display: flex;
        align-items: flex-start;
        width: 48%;
        padding-top: 24px;
    }

    .wrapper .comments ul li img {
        padding-right: 16px;
        max-width: 164px;
        max-height: 164px;
    }

    /* @supports (-ms-ime-align: auto) {
        .wrapper .comments ul li img {
            min-width: 125px;
            min-height: 125px;
        }
    } */

    .wrapper .comments ul li dl dt {
        font-size: 18px;
        font-weight: bold;
        font-family: 'Hiragino Kaku Gothic Pro', 'ヒラギノ角ゴ Pro W6', 'メイリオ', Meiryo, 'ＭＳ Ｐゴシック', sans-serif;
    }

    .wrapper .comments ul li dl dd {
        font-size: 14px;
    }

    .wrapper .recommended .item1 {
        margin-top: 46px;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        -webkit-align-items: flex-start;
        align-items: flex-start;
    }

    .wrapper .recommended .item2 {
        margin-top: 110px;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        -webkit-align-items: flex-start;
        align-items: flex-start;
        -webkit-flex-direction: row-reverse;
        flex-direction: row-reverse;
    }

    .wrapper .recommended .desc {
        width: 48%;
        padding-top: 32px;
    }

    .wrapper .recommended .item_img {
        position: relative;
        width: 48%;
    }

    .wrapper .recommended .quantity {
        position: absolute;
        top: 16px;
        left: 16px;
        font-size: 16px;
        padding: 3px 14px;
        border: 1px solid #ff0033;
        color: #ff0033;
        background: #fff;
    }

    .wrapper .recommended .desc dl dt {
        font-size: 34px;
        font-weight: bold;
        font-family: "ヒラギノ明朝 ProN W6", "HiraMinProN-W6", "HG明朝E", "ＭＳ Ｐ明朝", "MS PMincho", "MS 明朝", serif;
        margin-right: 90px;
        line-height: 1.4;
    }

    .wrapper .recommended .inner .desc dl dd {
        font-size: 16px;
        margin-right: 90px;
    }

