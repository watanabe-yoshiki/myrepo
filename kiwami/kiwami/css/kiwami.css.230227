@charset "utf-8";

@import url('https://fonts.googleapis.com/css?family=Noto+Sans+JP&display=swap');
@import url('https://fonts.googleapis.com/css?family=Noto+Serif+JP&display=swap');

/* http://meyerweb.com/eric/tools/css/reset/
v2.0 | 20110126
License: none (public domain)
*/
* { box-sizing:border-box; }
html, body, div, span, applet, object, iframe,h1, h2, h3, h4, h5, h6, p, blockquote, pre,a, abbr, acronym, address, big, cite, code,del, dfn, em, img, ins, kbd, q, s, samp,small, strike, strong, sub, sup, tt, var,b, u, i, center,dl, dt, dd, ol, ul, li,fieldset, form, label, legend,table, caption, tbody, tfoot, thead, tr, th, td,article, aside, canvas, details, embed, figure, figcaption, footer, header, hgroup, menu, nav, output, ruby, section, summary,time, mark, audio, video { margin: 0; padding: 0; border: 0; font-size: 100%; /*font: inherit;*/ vertical-align: baseline; }
article, aside, details, figcaption, figure, footer, header, hgroup, menu, nav, section { display: block; }
body { line-height: 1; }
ol, ul { list-style: none; }
blockquote, q { quotes: none; }
blockquote:before, blockquote:after,q:before, q:after { content: ''; content: none; }
table { border-collapse: collapse; border-spacing: 0; }

/*
HTML5 display-role reset for older browsers
*/
article, aside, details, figcaption, figure, footer, header, hgroup, menu, nav, section { display: block; }
body { line-height: 1; }
ol, ul { list-style: none; }
blockquote, q { quotes: none; }
blockquote:before, blockquote:after,q:before, q:after { content: ''; content: none; }
table { border-collapse: collapse; border-spacing: 0; }
button { -webkit-appearance: button; appearance: none; background-color: transparent; border: none; cursor: pointer; outline: none; padding: 0; -webkit-tap-highlight-color: rgba(0,0,0,0); box-sizing: border-box; }
input, textarea, select { -webkit-appearance: none; appearance: none; outline: none; }
input:focus,textarea:focus { outline: none; }
input::-moz-focus-inner,button::-moz-focus-inner { border: 0; }
a { color: #000000; text-decoration: none; -webkit-tap-highlight-color: rgba(0,0,0,0); }
a,a:focus { outline: none; }
img { border: none; vertical-align: bottom; }


body { width: 100%; min-width: 320px; margin: 0;
	font-family: "ヒラギノ明朝 ProN W3", "Hiragino Mincho ProN", "游明朝", "Yu Mincho", YuMincho, 'Noto Serif JP', "HG明朝E", "ＭＳ Ｐ明朝", "ＭＳ 明朝", serif;
	font-weight: 400; -webkit-text-size-adjust: 100%; font-size: 14px; line-height: 1.5; letter-spacing: 0.1em; color: #222;
	/*background:url("../img/bg_check.jpg") #000;*/ }
body, ol, ul, dl, dt, dd, h1, h2, h3, h4, h5, h6, h7, form, p,div { margin:0; padding:0; box-sizing: border-box; }
img { border: 0; user-select: none; -webkit-user-select: none; -moz-user-select: none; -khtml-user-select: none; -webkit-user-drag: none; -khtml-user-drag: none; vertical-align: bottom; }
img { max-width: 100%; height:auto; }
li { list-style-type: none; }
table, tr, td { border-style: none; vertical-align: top; }
html { font-size: 100%; }

/* IE,Android */
body.ie {font-family: 'Noto Sans JP', Meiryo, sans-serif;}

/* a-link */
a { text-decoration: none; color: inherit; overflow: hidden; -webkit-transition: .2s linear; -moz-transition: .2s linear; -o-transition: .2s linear; }
a img { -webkit-transition: .2s linear; -moz-transition: .2s linear; -o-transition: .2s linear; transition: .2s linear; }
/*a:hover { opacity: 0.7;}*/

.sans{font-family: "ヒラギノ明朝 ProN W3", "Hiragino Mincho ProN", "游明朝", "Yu Mincho", YuMincho, 'Noto Serif JP', "HG明朝E", "ＭＳ Ｐ明朝", "ＭＳ 明朝", serif;}
.gothic {font-family: 'Yu Gothic', 'YuGothic', 'Hiragino Kaku Gothic ProN', 'Meiryo', sans-serif;}

.f_left{float: left;}
.f_right{float: right;}
.txt_l{text-align:left!important;}
.txt_c{text-align:center!important;}
.txt_r{text-align:right!important;}
.no-pc {display: none !important;}
.no-sp {display: block !important;}

/* clearfix */
.clearfix:after { visibility: hidden; display: block; font-size: 0; content: " "; clear: both; height: 0; }
 * html .clearfix { zoom: 1; }
 *:first-child+html .clearfix { zoom: 1; }
.clearfix:before,.clearfix:after { content: " "; display: table}
.clearfix:after { clear: both}
.clearfix:after { content: "."; display: block; height: 0; clear: both; visibility: hidden; }
.clearfix {display: inline-table;}

/* Hides from IE-mac \*/
* html .clearfix {height: 1%;}
.clearfix {display: block;}
/* End hide from IE-mac */

/* IE */
body.ie {
  font-family: Verdana, Meiryo, sans-serif;
}

.header-nav .bnr { display:none!important; }


@media screen and (min-width: 1001px) {

  .con { width: 56.8%; margin: auto;}
	.offset-l { margin-left: 21.6%;}

  .hover_elem a:hover { filter: alpha(opacity=80); opacity: 0.8; }
  .hover_img a:hover img  { filter: alpha(opacity=80); opacity: 0.8; }
  .hover {
	  -webkit-transition:.2s linear;
	  -moz-transition:.2s linear;
	  -o-transition:.2s linear;
	  transition:.2s linear;
  }
  .hover:hover { filter: alpha(opacity=80); opacity: 0.8; }
}

#top-mv { min-height:400px;padding-top: 20px; position:relative;background: url(../img/top-mv/bg-check.png) repeat #000;}
#top-mv .offset-l {position: relative;z-index: 20;}
#top-mv .offset-l > * {margin: 0 20px;}
#top-mv .mv-bg {background: url(../img/top-mv/mv-map.png) center / contain no-repeat;}
#top-mv .mv-bg figure {text-align: center;margin: 30px 20px;}
#top-mv .lead {color: #fff; font-size: 18px;}
#top-mv .num {margin: 1em 0; color: #fff;}
#top-mv .all {color: #000; font-size: 20px;font-weight: bold; display: inline-block; text-align: center;padding: 10px 30px;margin-bottom: 20px;background-color: #CC9933; transition: .3s; letter-spacing: 0.08em;}
#top-mv .all:hover {opacity: .7;}
#top-mv .all small {display: block;font-size: 14px;}

#top-mv .slider {width:100%;}
#top-mv .slider div { height:100%; }
#top-mv .slider li { width:100%; height:100%;outline: none;}
#top-mv .slider a {display: block;}
#top-mv .slider a:hover {opacity: .7;}
#top-mv .slider figure {;width: 100%;padding-bottom: 36%;background: center / cover no-repeat;}

/* pagelink
------------------------------------------------------------*/
.pagelink {padding-top: 20px;}
.pagelink .pagelink-list {margin:0 20px; display: flex; justify-content: space-between;}
.pagelink .pagelink-list li {width: 100%;border: 1px solid #ccc;}
.pagelink .pagelink-list li a {display: block;}
.pagelink .pagelink-list li a img {width: 100%;}
.pagelink .pagelink-list li a:hover {opacity: .7;}

/* fixedBnr
------------------------------------------------------------*/
.fixedBnr {position: fixed; right: 3%; top: 50%; width: 14%; transform: translateY(-50%); z-index: 100;}

/* bnr
------------------------------------------------------------*/
.bnr { padding: 20px 0; }
.bnr .bnr-list { margin:0 20px; display:flex;justify-content:space-between; flex-wrap: wrap; gap: 20px 0;}
.bnr .bnr-list li {  border:1px solid #ccc;/*flex: 1;*/ width: 49%;}
.bnr .bnr-list li.full {width: 100%;}
.bnr .bnr-list li > a {display: flex;align-items: center;justify-content: center;height: 100%;}
.bnr .bnr-list li > a img {width: 100%;}
.bnr .bnr-list a:hover { opacity:0.7; }
.bnr .bnr-list .link {display: flex;margin: 10px 5px;}
.bnr .bnr-list .link a {display: flex;justify-content: center;align-items: center;background-color: #CC9933;color: #fff;flex: 1;margin: 0 5px;text-align: center;border-radius: .5em;font-size: 14px;padding: .5vw 4px;position: relative;overflow: inherit;letter-spacing: 0;}
.bnr .bnr-list .link a .card {position: absolute;right: -5px;top: -10px;height: 110%}
.bnr .bnr-list .link a:hover {opacity: .7;}
.bnr .bnr_instagram {width: 74%; margin: 30px auto 0;}
.bnr .bnr_instagram .sp-img {display: none;}
.bnr .bnr_instagram a {display: block;}
.bnr .bnr_instagram a:hover {opacity: .7;}

/* news
------------------------------------------------------------*/
.news {margin: 20px 0; font-family: "ヒラギノ角ゴ ProN W3", "Hiragino Kaku Gothic ProN", "游ゴシック", YuGothic, "メイリオ", Meiryo, sans-serif;}
.news-inner {margin: 0 20px; padding: 15px 0; display: flex; justify-content: space-between; align-items: center;}
.news-ttl {width: 125px; padding: 0 25px; color: #707070; font-size: 24px;}
.news-list {width: calc(100% - 50px); padding-left: 25px; border-left: 1px solid #707070;}
.news-list > li {text-indent: -1em; margin-left: 1em;}
.news-list > li:before {content: "・";}
.news-list > li + li {margin-top: 0.5em;}
.news-list > li a {color: #707070; font-size: 16px;}
.news-list > li a:hover {text-decoration: underline;}

/* panel
------------------------------------------------------------*/
.panel .offset-l > * {margin: 0 10px;}
.panel h2 {text-align: center;padding-bottom: 30px;}
.panel h2.father img{height: ;}
.panel .panel-list::after {content: "";display: block;clear: both;}
.panel .panel-list li {float: left;width: 25%;position: relative; height: 0; padding-bottom: 25%;}
.panel .panel-list li.clear-pc {clear: both;}
.panel .panel-list li a {display: block;}
.panel .panel-list li.big {width: 50%;padding-bottom: 50%;}
.panel .panel-list li.big.right {float: right;}
.panel .panel-list li img {width: calc(100% - 20px);margin: 10px;}
.panel .panel-list li .detail {position: absolute;left: 10px;top: 10px;width: calc(100% - 20px);height: calc(100% - 20px);background-color: rgba(0, 0, 0, 0.7);color: #fff;display: flex;flex-direction: column;justify-content: center;align-items: center;font-size: 18px;font-family: 'Noto Sans JP', Meiryo, sans-serif;text-align: center;opacity: 0;transition: .3s;}
.panel .panel-list li:hover .detail {opacity: 1;}
.panel .panel-list li .detail p + p {margin-top: 20px;}
.panel .panel-list li .detail .price {font-size: 16px;}
.panel .panel-list li .detail p.detailBtn {display: inline-block;background-color: #fff;color: #666666;padding: 5px 20px;font-weight: bold;margin-top: 30px;font-size: 16px;width: 200px;text-align: center;border-radius: 2em}
.panel .panel-list li .detail p.detailBtn:hover {background-color: #ccc;}

/* feature
------------------------------------------------------------*/
#feature {padding: 0px 0 70px;}

/* ranking
------------------------------------------------------------*/
#ranking {padding-bottom: 70px;}
#ranking.panel h2 img {height: 30px;}

/* mothersday
------------------------------------------------------------*/
#mothersday {padding-bottom: 70px;}
#mothersday.panel h2 img {height: 70px;}

/* fathersday
------------------------------------------------------------*/
#fathersday {padding-bottom: 70px;}
#fathersday.panel h2 img{height: 70px;}



/* blog
------------------------------------------------------------*/
#blog {background-color: #666633;padding: 40px 0 ;}
#blog .offset-l > * {margin: 0 20px;}
#blog h2 {text-align: center;font-size:2em;font-weight:400;letter-spacing:.1px;color: #fff;display: flex;justify-content: center;align-items: center;padding-bottom: 10px;}
#blog h2:before,
#blog h2:after {content: '';flex: 1;display: block;background-color: #fff;height: 1px;}
#blog h2:before{margin-right: 20px;}
#blog h2:after {margin-left: 20px;}
#blog .blog-list li {margin-top: 20px;}
#blog .blog-list li a {display: flex;flex-wrap: wrap;align-items: center;background-color: #F2F0E4;padding: 20px;}
#blog .blog-list li a:hover {opacity: .7;}
#blog .blog-list li a .img {width: 50%;margin-right: 20px;}
#blog .blog-list li a .txt {flex: 1;}
#blog .blog-list li a h3 {font-size: 22px;margin-bottom: 10px;}
#blog .blog-list li a .txt-sub {display: flex;flex-wrap: wrap;}
#blog .blog-list li a .txt-sub figure {width: 130px;}
#blog .blog-list li a p {color: #666633;position: relative;font-size: 18px;flex: 1;letter-spacing: 0;margin-right: 20px;}
#blog .blog-list li a p .right {display: block;text-align: right;margin-top: 1em;font-size: 14px;}
#blog .btn-box {text-align: center;margin-top: 30px;}
#blog .btn-box a {background-color: #000;color: #fff;font-weight: bold;padding: 1em 2em;display: inline-block;}
#blog .btn-box a:hover {opacity: .7;}


/* shop
------------------------------------------------------------*/
#shop { margin:0;padding:60px 0;background:url(../img/main_bg.jpg) top left repeat; }
#shop .shop-inner { margin:0 20px; }
#shop h2 { margin:0 0 30px;padding:0;font-size:2.8em;font-weight:400;letter-spacing:.1px;color:#000 }
#shop h2 small { font-size:16px;display:inline-block; }
.shop-box { padding:20px 30px 30px;background:#fff;display:flex;justify-content:space-between;flex-wrap:wrap; }
.shop-box + .shop-box { margin-top:20px; }
.shop-box .name { margin:0 0 15px;padding:0;display:table;width:100%; }
.shop-box .name dt { display:table-cell;width:80px; vertical-align: middle;}
.shop-box .name dt span { display:block;padding:10px;font-size:1.1em;line-height:1;color:#FFF;background-color:#57297d;text-align:center; }
.shop-box .name dd { display:table-cell;width:calc(100% - 80px); }
.shop-box .name dd h3 { font-size:1.8rem;font-weight:normal;vertical-align:top;padding:0 0 0 10px; color: #000;}
.shop-box .column.view { width:45%; }
.shop-box .column.data { width:52%; }
.shop-box .column.data li { margin-bottom:5px;font-size:0.9em;color: #000; }
.shop-box .column.data li.attention { margin-top: 20px;color: #CC0000;padding-left:1em;text-indent:-1em; }
.shop-box .column.data li.link { margin-top:20px;text-align:right; }
.shop-box .column.data li.link a { display:inline-block;padding:8px;width:160px;text-align:center;border:#333 1px solid;color:#333;text-decoration:none; }
.shop-box .column.data li.link a:hover { background-color:#333;color:#FFF; }


/* story
------------------------------------------------------------*/
.story { padding:40px 0 60px;background:url(../img/bg_check.jpg) left top repeat;background-attachment:fixed; }
.story a { display:inline-block;position:relative; }
.story a:after { content:"";display:inline-block;width:100%;height:100%;background:#fff;position:absolute;top:0;left:0;z-index:0; }
.story a span { display:inline-block;position:relative;z-index:1;transition:.3s; }
.story a:hover span { opacity:0.8; }


/* ----------------------------------------
 * ボタン
 * ------------------------------------- */
.btn-box-01 { margin-top:20px;transition: opacity 0.3s ease 0s; }
.btn-box-01 a {
	position: relative;/*display: block;*/margin:auto;width: 80%;height: 60px;/*padding: 22px 0 0 0;text-align: center;*/color:#FFF;font-size:1.2em;line-height:1;
	background-color: #000;
	background: -moz-linear-gradient(top, #af8b0d, #dbb12e);
	background: -webkit-linear-gradient(top, #af8b0d, #dbb12e);
	background: linear-gradient(to bottom, #af8b0d, #dbb12e);
	display:flex; justify-content:center; align-items:center; }
.btn-box-01 a:hover {text-decoration:none;opacity: 0.7;}
.btn-box-01 a:after {content: "";position: absolute;display: block;background-position: left top;background-repeat: no-repeat;top: 25px;right: 21px;width: 7px;height: 13px;background-image: url(../img/icn_arrow_right_white_01.png); }


/* TAB */
@media screen and (max-width:1200px) {
	.bnr .bnr-list .link a .card {height: 90%;}
	.panel .panel-list li .detail {font-size: 14px;}
	.panel .panel-list li .detail p.detailBtn {width: auto;font-size: 14px;}
}
@media screen and (max-width:1000px) {
	#top-mv {padding-top: 65px;}
	#top-mv .mv-bg figure {margin: 20px 20px 10px;}
	#top-mv .mv-btn { top:20px; right:20px; transform:none; }
	#top-mv .txt h2 { font-size:30px; }
	#top-mv .txt p { font-size:18px; }
	#top-mv .txt p br.sp { display:inline; }
	
	.bnr .bnr-list .link a .card {height:26px;}

	.panel .panel-list li .detail {opacity: 1;background: none;}
	.panel .panel-list li .detail p {display: none;}
	.panel .panel-list li .detail p.detailBtn {background: none;margin: 0;position: absolute;top: 0;left: 0;width: 100%;height: 100%;border-radius: 0;font-size: 0;}
	.panel .panel-list li .detail p.detailBtn:hover {background: none;}
	
	#blog .blog-list li a {flex-direction: column;}
	#blog .blog-list li a .img {width: 100%;margin-right: 0;margin-bottom: 20px;}
	#shop { padding:40px 0; }
	#shop h2 {font-size: 2.2em;}
	.shop-box .name dd h3 {font-size: 1.4rem;}

	.story { padding:40px 20px 60px; }
}

/* SP */
@media screen and (max-width:700px) {
	.story a img { width:100%; }
}
@media screen and (max-width:599px) {
	.no-pc {display: block !important;}
	.no-sp {display: none !important;}
	
	#top-mv { min-height:inherit;}
	#top-mv .offset-l > * {margin: 0;}
	#top-mv .slider figure {padding-bottom: 64%;}
	#top-mv .all {padding: 10px 20px;font-size: 16px;margin: 10px 0;}
	#top-mv .lead {margin-top: 1em; font-size: 16px;}

	.pagelink {padding-top: 10px;}
	.pagelink .pagelink-list {flex-wrap: wrap; margin: 0 10px;}

	.fixedBnr {right: 1%; width: 29%;}

	.bnr { padding: 10px 0; }
	.bnr .bnr-list { flex-direction: column;}
	.bnr .bnr-list {gap: 10px 0;}
	.bnr .bnr-list li {width: 100%;}
	.bnr .bnr_instagram {width: calc(100% - 20px); margin: 15px 10px 0;}
	.bnr .bnr_instagram .pc-img {display: none;}
	.bnr .bnr_instagram .sp-img {display: block;}

	.news-inner {margin: 0 10px; padding: 10px; background-color: #F5F5F5;}
	.news-ttl {width: 70px; padding: 0; font-size: 16px;}
	.news-list {padding-left: 10px; width: calc(100% - 80px);}
	.news-list > li a {font-size: 14px;}
	
	.panel h2 {margin-bottom: 20px;}
	.panel h2 img {height: 34px;}
	.panel .panel-list li {width: 50%;padding-bottom: 50%;}
	.panel .panel-list li.big {width: 100%;padding-bottom: 100%;}
	.panel .panel-list li.clear-pc {clear: none;}
	.panel .panel-list li.clear-sp {clear: both;}
	.panel .panel-list li img {width: calc(100% - 10px);margin: 5px;}
	
	#feature {padding: 0 0 30px;}
	#ranking {padding-bottom: 30px;}
	#ranking.panel h2 img {height: 20px;}
	#mothersday {padding-bottom: 30px;}
	#mothersday.panel h2 img {height: 40px;}
	#fathersday {padding-bottom: 30px;}
	#fathersday.panel h2 img {height: 40px;}
	#blog h2:before, #blog h2:after{content: none;}
	#blog .blog-list li a h3 {font-size: 18px;}
	#blog .btn-box a{margin-top: 30px;}
	#blog .blog-list li a p {font-size: 14px;}
	#blog .blog-list li a .txt-sub figure {width: 100px;}

	#shop h2 { font-size:1.7em; }
	.shop-box { display:block;padding:10px 20px 20px; }
	.shop-box .name dt { width:70px; }
	.shop-box .name dt span { font-size:0.8rem; }
	.shop-box .name dd { width:calc(100% - 70px); }
	.shop-box .name dd h3 { font-size:1.1rem; }
	.shop-box .column.view, .shop-box .column.data { width:100%; }
	.shop-box .column.view { margin-bottom:15px; }
	.shop-box .column.view img { width:100%; }
	.shop-box .column.data li.link { margin-top:15px; }

	.btn-box-01:hover { opacity: 1; }

	.anchor {padding-top: 65px; margin-top: -65px;}
}
@media screen and (max-width:480px) {
	.bnr .bnr-list,
	#blog .offset-l > *{margin: 0 10px;}
	.panel .offset-l > * {margin: 0 5px;}
	.panel h2 img {height: 24px;}
	#blog h2 {font-size: 20px;}
	#blog .blog-list li {margin-top: 20px;}
	#blog .blog-list li a .txt-sub figure {width: 80px;}

	.shop-box .name { display:block;padding-top:5px; }
	.shop-box .name dd { display:block; width:100%; }
	.shop-box .name dd h3 { padding:5px 0 0; }
}
