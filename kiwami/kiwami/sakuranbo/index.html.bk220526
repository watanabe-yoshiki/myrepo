    <section id="block-review">
      <div class="container">
        <h2 class="ttl"><img src="images/review_ttl.png" alt="美食のスペシャリストが絶賛！" width="532" height="38"></h2>

        <ul class="list-review">
          <li>
            <a href="https://blog.ringbell.co.jp/entry/2021/07/09/000000" target="_blank">
              <div class="img">
                <img src="images/review_img01.jpg" alt="佐藤錦のコンポート">
                <p class="person"><img src="images/review_person01.png" alt="料理家・大西綾美"></p>
              </div>
