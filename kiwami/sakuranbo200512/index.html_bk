<script>
	$(function () {
	$('.item_button').prevAll().hide();
	$('.item_button').click(function () {
	if ($(this).prevAll().is(':hidden')) {
	$(this).prevAll().slideDown();
	$(this).children('img').attr("src", $('.item_button img').attr("src").replace("-more", "-close"));
	} else {
	$(this).prevAll().slideUp();
	$(this).children('img').attr("src", $('.item_button img').attr("src").replace("-close", "-more"));
	}
	});
	});
</script>

<script>
    $(function(){
      $('#voices dl').matchHeight();
    });
</script>

<script>
	// モーダルが複数ある場合
	$(function () {
	// モーダルのボタンをクリックした時
	$('.modal_trigger .modal_btn').on('click', function() {
	var btnIndex = $(this).index(); // 何番目のモーダルボタンかを取得
	$('.modal_area .modal_box').eq(btnIndex).fadeIn(); // クリックしたモーダルボタンと同じ番目のモーダルを表示する
	});

	// ×やモーダルの背景をクリックした時
	$('.modal_close , .modal_bg').click(function(){
	$('.modal_box').fadeOut(); // モーダルを非表示にする
	});
	});
</script>

